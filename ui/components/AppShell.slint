// Composition of the client area below the native OS title bar: sidebar +
// editor, plus the scrim behind overlays and the delete's 撤销 bar. No business
// logic here — state flows through the UIState global, actions flow to the Rust
// controller.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { IconButton } from "./IconButton.slint";
import { Icon } from "../Icons.slint";
import { Sidebar } from "./Sidebar.slint";
import { Editor } from "./Editor.slint";
import { OrganizerArea } from "./OrganizerArea.slint";
import { SettingsDialog } from "./SettingsDialog.slint";
import { Button } from "./Button.slint";
import { UIState } from "../Types.slint";

export component AppShell inherits Rectangle {
    property <bool> overlay-open: UIState.palette-open
        || UIState.search-open
        || UIState.menu-open
        || UIState.dialog-open
        || UIState.link-open
        || UIState.slash-open
        || UIState.block-menu-open-id >= 0
        || UIState.icon-picker-open;

    // The three cards that block the page underneath them, as opposed to the
    // popups that hang off an element the user is already looking at. Only
    // these dim the page: an anchored menu with a dark band behind it reads
    // as a rendering fault, not as focus.
    property <bool> modal-open: UIState.dialog-open
        || UIState.link-open;

    VerticalLayout {
        width: root.width;
        height: root.height;
        // The native OS title bar is outside the client area. Notices and the
        // app content begin directly below it, without a second drawn title row.
        if UIState.db-notice != "" && UIState.active-area != "organizer" : Rectangle {
            height: 30px;
            background: Theme.dark ? #3d3517 : #f6e7b2;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-xs;
                spacing: Theme.spacing-sm;
                Text {
                    text: UIState.db-notice;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Theme.dark ? #e8d48a : #5a4a17;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                IconButton {
                    vertical-stretch: 0;
                    cross-axis-self-alignment: center;
                    icon-name: "x";
                    size: 22px;
                    clicked => {
                        UIState.close-db-notice();
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            max-height: 100000px;
            Sidebar {}
            // The top-level areas, chosen by `active-area`, and this is the
            // **only** place they are chosen between — the editor is not a child
            // of the organizer nor the other way round, and a keystroke can only
            // ever reach the one that is mounted. (The 同步 page that used to be
            // the third area lives on as the settings page's 同步 tab.)
            if UIState.settings-open : SettingsDialog {}
            // The notes toolbar asks the window how wide it is, because the
            // organizer cannot: its own width is what its rows ask for, and a row
            // that shrinks itself to fit is a binding loop. 930 px is the area
            // width at which the toolbar's five fixed parts plus three labelled
            // tools reach the column's right edge (`OrganizerArea.tools-worded`).
            if !UIState.settings-open && UIState.active-area == "organizer" : OrganizerArea {
                tools-worded: root.width
                    - (UIState.sidebar-open ? Theme.sidebar-width : 0px) >= 930px;
            }
            if !UIState.settings-open && UIState.active-area != "organizer" : Editor {}
        }
    }

    // The 撤销 bar of a deferred delete (ADR-0108). Window-level rather than a
    // child of `OrganizerArea`, because the pending delete outlives the area it
    // was asked from: leave for the editor and the rows are still waiting behind
    // this bar, which is the only way back to them.
    //
    // Floating at the bottom rather than a band in the vertical layout, because a
    // band would push the area's three columns around every time a delete is
    // asked for, and a delete is not worth moving the window's content over.
    //
    // The width is a constant rather than `preferred-width` arithmetic because a
    // `HorizontalLayout` carries no background, so the pill has to be a Rectangle
    // that spells its own size. A definite width is what lets the layout inside
    // give the text the slack (`horizontal-stretch`) and the button its preferred
    // width — and a long note title elides instead of pushing 撤销 off the window.
    Rectangle {
        x: parent.width - self.width - Theme.spacing-xl;
        y: parent.height - self.height - Theme.spacing-xl;
        visible: UIState.org-undo-text != "";
        width: 380px;
        height: 46px;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Colors.border-strong;
        background: Colors.surface-overlay;
        HorizontalLayout {
            padding-left: Theme.spacing-lg;
            padding-right: Theme.spacing-sm;
            spacing: Theme.spacing-md;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: UIState.org-undo-text;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: Colors.text-primary;
                overflow: elide;
            }
            Button {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                // Enabled by the same test that shows the pill, so a hidden bar
                // cannot hold a live TouchArea over the bottom-right of the window.
                enabled: UIState.org-undo-text != "";
                text: "撤销";
                primary: true;
                clicked => {
                    UIState.org-undo-delete();
                }
            }
        }
    }

    // The 已发送 toast. Bottom-centre, because that is the one spot free of both
    // the page's own furniture and the 撤销 pill parked at the bottom-right — and
    // under the 速记 flow the cursor is nowhere near here, so a toast that must be
    // clicked to leave would be a second chore. Rust arms the hide clock; the
    // click only gets there first.
    //
    // Success is painted rather than shouted: the theme's own accent carries the
    // badge and the border, over a soft ramp from `surface-overlay` down to
    // `accent-soft` (a hair of hue in an otherwise grey pill is what makes it
    // look deliberate rather than leftover). Slide-and-fade in, plain fade out —
    // the reverse animation is slowed, so leaving is quieter than arriving.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px
            + (UIState.capture-toast-visible ? 0px : 10px);
        width: 250px;
        height: 44px;
        visible: UIState.capture-toast-visible;
        border-radius: 22px;
        border-width: 1px;
        border-color: Colors.accent.with-alpha(0.38);
        background: @linear-gradient(
            175deg,
            Colors.surface-overlay,
            Colors.accent-soft
        );
        opacity: UIState.capture-toast-visible ? 1 : 0;
        animate opacity { duration: 260ms; }
        animate y { duration: 200ms; }
        HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-sm;
            spacing: Theme.spacing-sm;
            // The ✓ plate: an accent disc with the icon cut in `text-on-accent`,
            // the same contrast pair every filled accent control in the app uses.
            Rectangle {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Colors.accent;
                Icon {
                    x: 4px;
                    y: 4px;
                    name: "todo-check";
                    size: 16px;
                    color: Colors.text-on-accent;
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: UIState.capture-toast-text;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                font-weight: Typography.weight-medium;
                color: Colors.text-primary;
                overflow: elide;
            }
            IconButton {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                icon-name: "x";
                size: 24px;
                clicked => {
                    UIState.capture-toast-visible = false;
                }
            }
        }
        // A click anywhere on the pill dismisses it — the toast confirms, it does
        // not negotiate, so the TouchArea takes no action of its own.
        toast-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                UIState.capture-toast-visible = false;
            }
        }
    }

    // Scrim behind overlays. Menus/palette/search now auto-dismiss via
    // close-on-click-outside (the engine swallows the outside click while
    // a popup is open, so this TouchArea never sees it); the scrim remains
    // as a safety net for a UIState/popup desync: enabled while any
    // overlay flag is set, it dismisses everything on click.
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.overlay-open;
        // a modal over an undimmed page reads as a card pasted onto your
        // text (A4 LOW); an anchored popup keeps the page as-is
        background: root.modal-open ? Colors.scrim : transparent;
        scrim-ta := TouchArea {
            enabled: root.overlay-open;
            clicked => {
                UIState.palette-open = false;
                UIState.search-open = false;
                UIState.menu-open = false;
                UIState.dialog-open = false;
                UIState.link-open = false;
                UIState.slash-open = false;
                UIState.block-menu-open-id = -1;
                UIState.icon-picker-open = false;
            }
        }
    }
}
