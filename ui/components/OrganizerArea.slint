// SPEC §四十一's second top-level area: 笔记 and 任务.
//
// The shape is activitywatch's task page, ported: **one card**, and inside it
// three columns — the rows themselves, the selected row's *self*, and the nav
// column of views and tags on the **right**. The card is the page: a nav column
// that floated on the window background, a list that had no surface, and a
// detail panel that slid in and out made three unrelated panels out of one
// screen. The two 1px separators are drawn inset rather than bordered, because a
// border on a column would draw a line on all four of its sides.
//
// The nav is the card's *last* column (ADR-0112): 标签 in this area is a filter
// over the list beside it, and the reference puts the filter on the right — the
// side a right-handed pointer reaches without crossing the rows it is filtering.
// The order in this file is the order on screen, which is why the nav block sits
// at the bottom of the layout below.
//
// The rows are Rust's projections (`UIState.note-rows` / `task-rows` /
// `task-list-rows` / `org-board` / `org-tag-rows`) and the panes only place what
// they are handed — every word that is not a row's own text is decided here (the
// smart views' names, the priority glyphs), except the ones that need a clock (a
// relative age, the date "今天") and therefore come from Rust.
//
// What this file deliberately does **not** do: no hover-only affordance whose
// action is unreachable without a mouse, and no keyboard footer — the Android
// shell mounts this same component, where there is no Ctrl and no `↑↓/Enter`
// hints. The panes are side by side here because that is what 1280 px wants;
// that shell's own copy overrides the geometry it needs.
//
// Text fields are **drafts**. The detail pane's fields bind two-way to their own
// `org-*-draft` property and report the *field slot* they belong to
// (`org-field-edited`); Rust commits 300 ms later, exactly as a prose row and a
// database cell do, so one keystroke burst is one undo step instead of one per
// character. A checklist line follows the codebase's one-live-input discipline
// instead — several rows cannot share one draft — so a subtask is *text* until its
// row is clicked, and only that row renders an input.
//
// The magic numbers below are the **slots** the two sides agree on. This Slint
// build has no `const`, so they are literal and named here instead, in both
// directions:
//
//   field slot (`org-field`, `org-field-edited`)
//     1 note title · 2 note body · 3 note tags
//     4 task title · 5 task notes · 6 task tags · 8 task due
//     7 subtask title          (known to Rust as `ORG_FIELD_*`)
//   tab 0 笔记 · 1 任务          (`UIState.org-tab`)
//   view 0 收集箱 · 1 今天 · 2 近七天 · 3 全部 · 4 已完成  (`UIState.org-view`)
//   sort 0 添加顺序 · 1 优先级 · 2 截止日期                      (`UIState.org-sort`)
//   mode 0 列表 · 1 平铺                                       (`UIState.org-mode`)

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { IconButton } from "./IconButton.slint";
import { OrgButton } from "./OrgButton.slint";
import { NoteCaptureCard } from "./NoteCaptureCard.slint";
import { UIState, BoardCard, BoardColumn, TaskRow, NoteRow } from "../Types.slint";

// ---- local vocabulary ----

// A field's label, to the left of its control.
component OrgField inherits Text {
    in property <string> name;
    text: root.name;
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    color: Colors.text-muted;
    vertical-alignment: center;
    overflow: elide;
}

// One row of 详细信息. The label is the reference's word and the value is text
// Rust already decided, so this row never computes anything — it places two
// strings and elides the one that can be long (a note's tag list).
component OrgDetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 22px;
    spacing: 8px;
    cross-axis-alignment: center;
    OrgField { name: root.label; width: 40px; }
    Text {
        text: root.value;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One row of the nav column: the icon-less view rows, and the lists below them.
// 34 px rather than the page's list height — a nav is scanned, not read, and a
// selected row says so three ways (fill, left bar, weight) so no one cue has to
// carry it alone.
//
// A **tag** row is also the 反向筛选 control: the circled slash at its right edge
// hides this path — and everything under it — or stops hiding it. Drawn and not
// typed, because `⊘` is not in this app's font chain (the trap the bar's `✕`
// fell into): a `Text` of a glyph no face carries is an invisible control whose
// `TouchArea` still answers. The slash is two `Rectangle`s, so it renders
// whatever the machine's fonts are.
component OrgNavRow inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;        // < 0 paints no count
    in property <length> row-height: 32px;
    in property <length> label-size: Typography.size-ui;
    in property <length> count-size: Typography.size-caption;
    in property <int> color-slot: -1;   // >= 0 draws the list's dot
    in property <bool> selected: false;
    in property <bool> accent: false;
    // This row is a tag path that can be hidden, and whether it is hidden now.
    in property <bool> excludable: false;
    in property <bool> excluded: false;
    // A stored list row: its ⋯ opens the shared context menu (rename / colour /
    // delete), and it can be renamed inline — the sidebar's own idiom, kept in the
    // row it renames rather than in a dialog.
    in property <bool> menuable: false;
    in property <bool> renaming: false;
    // The rail's counts are **pills**, not trailing digits (the prototype's
    // `.tnum`): a mono number in a hairline plate, so a stack of counts reads as
    // data rather than as words that happen to be numbers. A flag rather than a
    // second component because everything else about the row is already right.
    in property <bool> count-pill: false;
    callback clicked();
    callback exclude-toggled();
    callback menu-requested(length, length);
    callback rename-committed(string);
    callback rename-cancelled();

    height: root.row-height;
    border-radius: Theme.radius-sm;

    // What the text must leave room for: the count, then the exclude control, then
    // the ⋯. One property rather than three subtractions, because a `Text`'s width
    // is a `length` and nesting the arithmetic inside it is how a row elides to "…".
    private property <length> right-inset:
        (count > 0 ? count-text.preferred-width + (count-pill ? 22px : 16px) : 13px)
        + (excludable ? 24px : 0px)
        + (menuable ? 22px : 0px);

    // A selected row is a **state, not an emphasis** (the same rule `OrgFilterChip`
    // states, and the same reason: `Colors.surface-selected` is accent-tinted, and
    // a row that is selected *by default* — 全部笔记, lit whenever no tag filter is
    // on — then shouts about the one thing the user already knows). A nav draws
    // the lit row as a raised surface with a 2 px accent bar down its left edge
    // and the label in the primary colour: three cues, none of them a saturated
    // plate. The bar is also what tells a long label where it starts.
    background: selected
        ? (UIState.org-tab == 0 ? Colors.surface-selected : Colors.surface-overlay)
        : (ta.has-hover ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    if selected : Rectangle {
        x: 0;
        y: 5px;
        width: 2px;
        height: parent.height - 10px;
        border-radius: 1px;
        background: Colors.accent;
    }

    if color-slot >= 0 : Rectangle {
        x: 13px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Colors.block-text(color-slot);
    }
    nav-text := Text {
        x: color-slot >= 0 ? 29px : 13px;
        width: parent.width - self.x - root.right-inset;
        height: parent.height;
        // The rename input takes this slot's place while it is up, so a renamed
        // row is one row and not a row with a second copy of its name under it.
        visible: !root.renaming;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: root.label-size;
        font-weight: root.selected ? Typography.weight-semibold : Typography.weight-regular;
        color: root.excluded ? Colors.text-muted
            : (root.accent ? Colors.accent-text
            : (root.selected ? Colors.text-primary : Colors.text-secondary));
        vertical-alignment: center;
        overflow: elide;
    }
    // The plate behind a pill count. Declared *before* the number so the number is
    // above it, and sized off `count-text.preferred-width` rather than the other way
    // round: the text keeps its own right-edge geometry, which is what `right-inset`
    // above measures the label against.
    if root.count-pill : Rectangle {
        x: parent.width - (count-text.preferred-width + 14px)
            - (root.excludable ? 26px : 12px) - (root.menuable ? 22px : 0px);
        y: (parent.height - 18px) / 2;
        width: count-text.preferred-width + 14px;
        height: 18px;
        border-radius: 9px;
        border-width: 1px;
        border-color: root.selected ? Colors.accent.with-alpha(0.40) : Colors.border;
        background: Colors.surface;
        visible: root.count > 0 && !root.renaming;
    }
    count-text := Text {
        x: parent.width - count-text.width - (root.excludable ? 26px : 12px)
            - (root.menuable ? 22px : 0px) - (root.count-pill ? 7px : 0px);
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        visible: root.count > 0 && !root.renaming;
        text: root.count;
        font-family: root.count-pill ? Typography.mono-font : Typography.ui-font;
        font-size: root.count-size;
        color: root.selected ? Colors.accent-text : Colors.text-muted;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    // Last, so it is *above* `ta`: a control under the row's own hit area is a
    // control that cannot be clicked.
    //
    // A circled bar rather than the reference's `⊘`: this build's Slint has no
    // `rotation-angle` on a `Rectangle`, so a slashed circle would have to be a
    // rotated rectangle it cannot draw or a `Text` of a glyph this font chain does
    // not carry. 减 is the same idea in a shape that renders everywhere.
    if root.excludable : Rectangle {
        x: parent.width - 21px;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        border-radius: 8.5px;
        border-width: 1px;
        border-color: root.excluded ? Colors.danger : Colors.border-strong;
        background: root.excluded ? Colors.danger.with-alpha(0.12)
            : (excl-ta.has-hover ? Colors.hover-fill : transparent);
        Rectangle {
            x: (parent.width - 9px) / 2;
            y: (parent.height - 1.5px) / 2;
            width: 9px;
            height: 1.5px;
            background: root.excluded ? Colors.danger : Colors.text-muted;
        }
        excl-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.exclude-toggled(); }
        }
    }
    // The ⋯ that opens the shared context menu — 重命名 / 颜色 / 删除清单. Drawn on
    // hover or when the row is the selected one, the way a task row's own ⋯ is, and
    // after `ta` so it is *above* the row's hit area.
    if root.menuable : IconButton {
        x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2;
        icon-name: "dots-horizontal";
        icon-color: Colors.text-muted;
        size: 20px;
        visible: !root.renaming && (ta.has-hover || root.selected);
        clicked => {
            root.menu-requested(self.absolute-position.x, self.absolute-position.y);
        }
    }
    // Inline rename, the sidebar's own shape: Enter commits, Escape puts the old
    // name back. Above `ta`, because a field under the row's own hit area is a
    // field nobody can type into.
    if root.renaming : Rectangle {
        x: nav-text.x;
        y: (parent.height - 22px) / 2;
        width: parent.width - self.x - 13px;
        height: 22px;
        border-radius: Theme.radius-xs;
        background: Colors.background;
        border-width: 1px;
        border-color: Colors.accent;
        rename := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            vertical-alignment: center;
            font-family: Typography.ui-font;
            font-size: Typography.size-ui;
            color: Colors.text-primary;
            selection-foreground-color: Colors.text-primary;
            selection-background-color: Colors.selection;
            single-line: true;
            text: root.label;
            accepted => { root.rename-committed(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    accept
                } else {
                    reject
                }
            }
            init => {
                rename.focus();
                rename.select-all();
            }
        }
    }
}

// The tag column's whole content, so the two tabs share one implementation: the
// filter is the same question asked of whichever half is showing (the notes'
// tags or the tasks'), and a second copy of this would be a second set of rules
// about include, exclude and 清除筛选.
//
// 全部笔记 is deliberately *not* here — the 笔记 tab's own row above says it, and
// the tasks' smart views are where "everything" lives for that half.
component OrgTagColumn inherits VerticalLayout {
    spacing: 1px;

    // The way back up a level, and the path being filtered. A tag is a path, so
    // the column shows one level at a time: 项目 → 工作 → ActivityWatch is three
    // taps and this row is the way out of a wrong one.
    if UIState.org-tag != "" : OrgNavRow {
        label: "↑ 上级";
        count: -1;
        clicked => { UIState.org-tag-picked(UIState.org-tag-parent); }
    }
    Rectangle { height: 8px; }
    // The path being filtered, as a breadcrumb, and — under it — the paths being
    // *hidden*. Wrapped in a plate because a width inside the layout would be a
    // binding loop, and an elided path needs one.
    if UIState.org-tag != "" || UIState.org-tab != 0 : Rectangle {
        height: 22px;
        Text {
            x: 13px;
            width: parent.width - 26px;
            height: parent.height;
            text: UIState.org-tag == "" ? "标签" : UIState.org-tag-label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if UIState.org-excluded-label != "" : Rectangle {
        height: 22px;
        Text {
            x: 13px;
            width: parent.width - 26px;
            height: parent.height;
            text: UIState.org-excluded-label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.danger;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // One door out of both halves of the filter, and it exists only when there is
    // something to clear: a "clear" that clears nothing is noise in a nav.
    if UIState.org-tag != "" || UIState.org-excluded-label != "" : OrgNavRow {
        label: "清除筛选";
        count: -1;
        accent: true;
        clicked => { UIState.org-filters-cleared(); }
    }
    for tag[i] in UIState.org-tag-rows : OrgNavRow {
        // The rail's row is the prototype's `.tagrow`: a colour dot, the bare name,
        // a mono count in a pill. No `#` on the name — the dot is what says this row
        // is a tag, and a rail of `#`-prefixed paths is a wall of punctuation. The
        // pills *on the notes themselves* keep the `#`, because there the glyph is
        // the only thing distinguishing a tag from the sentence above it.
        label: tag.name;
        count: tag.count;
        row-height: UIState.org-tab == 0 ? 34px : 32px;
        label-size: Typography.size-ui;
        count-size: UIState.org-tab == 0 ? 10.5px : Typography.size-caption;
        count-pill: UIState.org-tab == 0;
        // The tag's own colour, the same slot its pill on a note draws — so the
        // filter and the thing it filters are visibly one thing, not two claims.
        color-slot: UIState.org-tab == 0 ? tag.color : -1;
        excludable: true;
        excluded: tag.excluded;
        // A chip shows the level *below* the filter, so it is never the selected
        // one — the row above it says where the filter is.
        selected: UIState.org-tag == tag.path;
        clicked => { UIState.org-tag-picked(tag.path); }
        exclude-toggled => { UIState.org-tag-excluded(tag.path); }
    }
}

// One pill of the 笔记 half's filter bar (ADR-0118). `OrgNavRow` is a full-width
// row with a left selection bar and a ⋯ — right for a nav column, wrong for a row
// of chips over a list that owns its card. This is that row's chip-sized twin: a
// label, the count it would leave, and the same ⊖ for 反向筛选.


// The toolbar's segmented control (列表 / 平铺). Two states, one box: the lit half
// is the answer, and the box itself is what says the two are alternatives.
component OrgSeg inherits Rectangle {
    in property <int> selected: 0;
    in property <[string]> labels: ["列表", "平铺"];
    callback picked(int);

    height: 26px;
    width: root.labels.length * 52px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Colors.border;
    background: transparent;
    clip: true;

    HorizontalLayout {
        for label[i] in root.labels : Rectangle {
            // The lit half is a wash of the accent with the label in the accent's
            // ink — the reference nav's own selected treatment (a 12–16% tint of
            // the accent, `kColorNavSel`), and the same "a state, not an
            // emphasis" rule the nav rows and the filter chips keep. `with-alpha`
            // and not a `mix`, because the blend's factor reads against the card
            // the box sits on and an alpha says the same thing without picking a
            // side in the palette.
            background: root.selected == i ? Colors.accent.with-alpha(0.15) : transparent;
            animate background { duration: Theme.duration-instant; }
            Text {
                text: label;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.selected == i ? Colors.accent-text : Colors.text-muted;
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

// The checkbox in front of a task and of a checklist line. A `Rectangle` and an
// `Icon` rather than a widget: this codebase has no checkbox control, and the
// to-do block's own box is drawn the same way. `round` is the task row's own
// shape — a circle, the way activitywatch's task page draws it.
component OrgCheck inherits Rectangle {
    in property <bool> checked: false;
    in property <int> priority: 0;
    private property <color> mark: priority == 3 ? Colors.danger
        : priority == 2 ? Colors.accent : priority == 1 ? Colors.success : Colors.accent;
    in property <length> box-size: 16px;
    in property <bool> round: false;
    callback toggled();

    width: box-size;
    height: box-size;
    border-radius: round ? box-size / 2 : 4px;
    background: checked ? root.mark : transparent;
    border-width: 1.5px;
    border-color: checked || root.priority > 0 ? root.mark : Colors.border-strong;

    if checked : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-size - 6px;
        height: root.box-size - 6px;
        name: "todo-check";
        size: root.box-size - 5px;
        color: Colors.text-on-accent;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}

// A row's tags and its age, on one muted line. Both are already-joined strings —
// a delegate never does string work in this codebase.
component OrgMeta inherits Text {
    in property <string> tags;
    in property <string> when;
    text: root.tags != "" && root.when != "" ? root.tags + " · " + root.when
        : (root.tags != "" ? root.tags : root.when);
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    color: Colors.text-muted;
    vertical-alignment: center;
    overflow: elide;
}

// One tag as a pill. `List ` + `tag` in the toolbar of activitywatch's page; here
// it is also how a row says which list it is in, which is why the tint is a
// property rather than a constant.
//
// The fill is the tint's own, at the reference pill's own two stops — a 12% wash
// of the colour inside a 30% border of it, text in the colour itself — because a
// wash of *the tag's colour* is what makes a row of pills read as a row of tags
// rather than as a row of gray chips that happen to have words in them.
component OrgPill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Colors.text-secondary;
    // A pill that filters when clicked carries its own TouchArea; the task
    // row's informational pills do not and must not swallow the row's click.
    // `value` is what a click reports — the note pill paints `#` + path and
    // reports the bare path, because the filter speaks in paths — and falls
    // back to the label, which is what an informational pill would be picked by.
    in property <bool> clickable: false;
    in property <string> value: "";
    callback picked(string);

    height: 17px;
    // `min()` rather than `max-width`: this build rejects a `width` and a
    // `max-width` on the same element, and a cap is what keeps a four-level
    // path from becoming the widest thing in its row.
    width: min(pill-text.preferred-width + (root.clickable ? 18px : 14px), 180px);
    border-radius: 9px;
    border-width: root.clickable ? 1px : 0px;
    border-color: root.tint.with-alpha(0.30);
    background: root.tint.with-alpha(0.12);
    pill-text := Text {
        x: root.clickable ? 9px : 7px;
        width: parent.width - self.x - (root.clickable ? 9px : 7px);
        height: parent.height;
        text: root.text;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: root.tint;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.clickable : pill-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(root.value == "" ? root.text : root.value); }
    }
}

// A priority, as the glyph activitywatch's task page uses: ▲ ◆ ▼ in the danger /
// accent / success colour, and nothing at all for "无". Four rows reading "高" is
// a column of noise; the word belongs in the detail panel, where it is a choice.
component OrgPrio inherits Text {
    in property <int> slot: 0;   // Priority slot: 0 none, 1 low, 2 medium, 3 high
    visible: root.slot > 0;
    width: 14px;
    horizontal-alignment: center;
    vertical-alignment: center;
    text: root.slot == 3 ? "▲" : (root.slot == 2 ? "◆" : "▼");
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    font-weight: Typography.weight-bold;
    color: root.slot == 3 ? Colors.danger
        : (root.slot == 2 ? Colors.accent-text : Colors.success);
}

// A deadline as a badge: boxed, so a date in a row of dates reads as one thing.
component OrgDue inherits Rectangle {
    in property <string> label;
    in property <bool> overdue: false;
    in property <bool> today: false;
    visible: root.label != "";

    height: 18px;
    width: due-text.preferred-width + 12px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.overdue ? Colors.danger : Colors.border;
    background: root.overdue ? Colors.danger.with-alpha(0.10) : transparent;
    due-text := Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: root.overdue ? Colors.danger
            : (root.today ? Colors.accent-text : Colors.text-muted);
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// One task as the list paints it: 52 px, because a row carries a title *and* a
// line of pills and 42 could not hold both. The whole row is the click target
// for selection; only the box toggles, and only the ⋯ opens the menu.
//
// The row's states are the reference's own four, and they are all *one* colour
// with the alpha doing the work: a wash of the accent inside a border of the
// same accent, with a 2 px bar down the left edge as the anchor. Hover is the
// faintest of the three, the detail-open row a step up, and 多选's pick the
// strongest — three intensities of one statement, "you are pointed at this",
// instead of three different colours.
component OrgTaskRow inherits Rectangle {
    in property <TaskRow> task;
    callback toggled();
    callback opened();
    callback menu-requested(length, length);

    private property <bool> has-metadata: task.due-label != "" || task.repeat > 0
        || task.tag-list.length > 0 || task.list > 0 || task.subtasks-total > 0;
    height: root.has-metadata ? 78px : 58px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: task.picked || task.selected ? Colors.accent.with-alpha(0.40) : Colors.border;
    background: task.picked || task.selected ? Colors.accent.with-alpha(0.08)
        : task-hover-ta.has-hover ? Colors.surface-hover : Colors.surface;
    animate background { duration: Theme.duration-instant; }
    animate border-color { duration: Theme.duration-instant; }

    // Put the row's broad selection target behind its child controls. When this
    // was last in paint order it covered OrgCheck, so a click on the circle only
    // opened the row and never reached the completion callback.
    task-hover-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        OrgCheck {
            // One box, two meanings: the row's done state normally, and the pick
            // while 多选 is on (ADR-0111) — the same box the reference swaps in
            // front of the same row. Which of the two a click means is Rust's
            // decision, so the callback is the one `toggled` already is.
            checked: UIState.org-selecting ? task.picked : task.done;
            box-size: 20px;
            priority: task.priority;
            round: !UIState.org-selecting;
            cross-axis-self-alignment: center;
            toggled => { root.toggled(); }
        }
        VerticalLayout {
            // The row's own growing column: everything else in the row is a
            // fixed-size control, and this is what takes the width left over.
            // `max-width` earns its place here for the reason the area's own
            // comment gives — a container of elidable text has a small preferred
            // width and no ceiling above it without this line.
            //
            // **No `alignment`**: this build's layout alignment reaches across
            // the axes, and a centered column took the title Rectangle at its
            // preferred width and parked it mid-row. The outer box's
            // `cross-axis-alignment` is the only centering the row needs.
            vertical-stretch: 0;
            horizontal-stretch: 1;
            max-width: 100000px;
            spacing: 3px;
            Rectangle {
                // Stretch hints, not `width: parent.width` — that binding loops
                // (the layout asks the child, the child asks the layout). This
                // layout's `alignment: center` takes a bare Rectangle at its
                // *preferred* width and centres it in both axes, which is how the
                // title once marched to the middle of the row; the stretch pin is
                // what holds it to the checkbox's right edge, and the strike line
                // under it to the text's own left.
                horizontal-stretch: 1;
                max-width: 100000px;
                height: 34px;
                // `x: 0` and a stated alignment: a Text floating in a plain
                // Rectangle centres itself in this build, and a title that
                // starts wherever the middle of the row is, is a title that
                // cannot be scanned down a list.
                task-title := Text {
                    x: 0;
                    horizontal-alignment: left;
                    text: task.title != "" ? task.title : "无标题";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    font-weight: Typography.weight-medium;
                    color: task.done ? Colors.text-muted : Colors.text-primary;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    width: parent.width;
                }
                // The strike, drawn: the reference animates its own across the
                // glyphs over 260 ms, which this renderer cannot trace — but the
                // line it ends at is one pixel through the x-height, the width of
                // the text that is actually there, and it is the only part of the
                // animation a static frame keeps.
                if task.done : Rectangle {
                    x: 0;
                    y: (parent.height - 1px) / 2 + 2px;
                    width: min(task-title.preferred-width, parent.width);
                    height: 1px;
                    background: Colors.text-muted;
                }
            }
            if root.has-metadata : HorizontalLayout {
                // The pills line is dropped whole when it is empty, so a row
                // without tags is one line of text rather than a gap.
                height: 17px;
                spacing: 6px;
        OrgDue {
            label: task.due-label;
            overdue: task.overdue;
            today: task.due == UIState.org-today;
        }
                if task.repeat > 0 : Icon {
                    name: "refresh"; width: 12px; height: 12px; size: 12px;
                    color: Colors.text-muted;
                }
                if task.list > 0 : OrgPill {
                    text: task.list-name;
                    tint: Colors.block-text(task.list-color);
                }
                for tag[i] in task.tag-list : OrgPill { text: tag; tint: Colors.accent-text; }
                if task.subtasks-total > 0 : Text {
                    text: "☑ " + task.subtasks-done + "/" + task.subtasks-total;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        OrgPrio { slot: task.priority; }

        if task.list > 0 : Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: Colors.block-text(task.list-color);
        }
        IconButton {
            icon-name: "dots-horizontal";
            icon-color: Colors.text-muted;
            size: 24px;
            // Gone while picking: every action it offers is one the bar has, and
            // a row menu over a row that is already a checkbox is two answers to
            // the same question. Gone in the bin as well, where the two verbs are
            // drawn instead — a menu that holds only 恢复 and 彻底删除 is a menu
            // that costs a click to say what a button already says.
            visible: !UIState.org-selecting && !UIState.org-bin-open;
            opacity: 1;
            clicked => {
                root.menu-requested(self.absolute-position.x, self.absolute-position.y);
            }
        }
        // 回收站: a binned task's own two verbs, in the row.
        if UIState.org-bin-open : OrgButton {
            label: "恢复";
            font-size: Typography.size-caption;
            clicked => { UIState.org-bin-restored(task.id); }
        }
        if UIState.org-bin-open : OrgButton {
            label: "彻底删除";
            font-size: Typography.size-caption;
            danger: true;
            clicked => { UIState.org-bin-purged(task.id); }
        }
    }
}

// The list's quick-add line. Enter commits — this is the one input in the area
// that is *not* a 300 ms draft, because a created row is a step and half a row
// is not. The trailing hint is the desktop's; the touch copy drops it.
component OrgQuickAdd inherits Rectangle {
    in property <string> placeholder;
    // The keyboard hint is the desktop's, and it is a *property* so the board's
    // columns can ask for none: 回车创建 under a ＋ line already says it, and the
    // touch copy of this component drops every such hint (SPEC §四十一).
    in property <string> hint: "回车创建";
    in-out property <string> value;
    callback submitted();

    height: 36px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    // The reference's own two steps on its quick-add line: the pointer teases
    // the border **toward** the accent (a 60% wash of it), the focus arrives at
    // it — an input that is being typed into is the one thing on the bar that
    // gets to glow.
    border-color: input.has-focus ? Colors.accent
        : (ta.has-hover ? Colors.accent.with-alpha(0.60) : Colors.border);
    background: Colors.surface-hover;

    if root.value == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 11px;
        y: 7px;
        width: parent.width - (hint.visible ? hint.width + 32px : 22px);
        height: parent.height - 14px;
        text <=> root.value;
        single-line: true;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-primary;
        vertical-alignment: center;
        selection-foreground-color: Colors.text-on-accent;
        selection-background-color: Colors.selection;
        accepted => { root.submitted(); }
    }
    hint := Text {
        x: parent.width - hint.width - 10px;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        visible: root.hint != "" && root.value == "";
        text: root.hint;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: Colors.text-muted;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
}

// One card of the board. Drag it to another column to move it there — the same
// drag the page tree and the document's rows use, so a card lifts the way every
// other draggable thing in this app lifts.
//
// The paint is the reference board's own arithmetic: a wash of the **ink** over
// the column (4.5%, 9% under the pointer) rather than an opaque surface step,
// because a column is already a panel and a card that is another opaque plate
// on it reads as a form field; and the border goes the accent's way under the
// pointer, which is what says "draggable, and this is the one you hold".
component OrgBoardCard inherits Rectangle {
    in property <BoardCard> card;
    callback toggled();
    callback opened();

    height: card-lay.preferred-height;
    // 拖拽中整卡变暗 (the reference's `setDimmed`): while this card *is* the
    // drag, the original dims to a ghost — what the pointer carries is the
    // idea of the card, and the thing left behind should not pretend to still
    // be it.
    opacity: drag.dragging ? 0.32 : 1.0;
    animate opacity { duration: Theme.duration-fast; }
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: card-ta.has-hover
        ? Colors.accent.with-alpha(0.50)
        : Colors.border.with-alpha(0.75);
    background: Colors.text-primary.with-alpha(card-ta.has-hover ? 0.09 : 0.045);
    animate background { duration: Theme.duration-instant; }
    animate border-color { duration: Theme.duration-instant; }

    card-lay := VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            OrgCheck {
                checked: card.done;
                box-size: 16px;
                round: true;
                toggled => { root.toggled(); }
            }
            card-text := Text {
                text: card.title != "" ? card.title : "无标题";
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                font-weight: Typography.weight-semibold;
                color: Colors.text-primary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            OrgPrio { slot: card.priority; }
        }
        // The meta line, the reference's own: priority glyph, deadline, then at
        // most **two** tag pills and a ＋N for the rest — a card is scanned, and
        // a row of six pills is a row of noise.
        HorizontalLayout {
            visible: card.due != "" || card.tag-list.length > 0;
            height: card.due != "" || card.tag-list.length > 0 ? 18px : 0px;
            spacing: 5px;
            OrgDue {
                label: card.due-label;
                overdue: card.overdue;
                today: card.due == UIState.org-today;
            }
            for tag[i] in card.tag-list : OrgPill {
                text: tag;
                tint: Colors.accent-text;
                visible: i < 2;
            }
            if card.tag-list.length > 2 : Text {
                text: "+" + (card.tag-list.length - 2);
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    drag := DragArea {
        enabled: true;
        allow-move: true;
        data: UIState.org-card-payload(card.id);
        drag-finished => { UIState.org-drop-list = -2; }
        // Keep the click target inside the drag source, as on the document
        // block handle: an ordinary click opens the task, while moving beyond
        // the drag threshold carries it to another list column.
        card-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.opened(); }
        }
    }
    // 落位环: a two-pixel accent ring around the card that just landed, popped
    // to full the moment the drop commits and walked back to nothing by the
    // six-hundred-millisecond fade Rust steps through (`org-settle-alpha`). The
    // "still blue after the rebuild" is the point — the board re-lays itself the
    // instant a card changes columns, and this is what tells the eye *which*
    // card it just watched move. Drawn a hair and a half outside the card's own
    // border, so the two read as a ring and not as a repaint.
    if UIState.org-settle-task == card.id : Rectangle {
        x: -1.5px;
        y: -1.5px;
        width: parent.width + 3px;
        height: parent.height + 3px;
        border-radius: Theme.radius-md + 1.5px;
        border-width: 2px;
        border-color: Colors.accent.with-alpha(UIState.org-settle-alpha);
        background: transparent;
    }
}

// The drop-gap placeholder, straddling the seam a card would drop across while a
// drag is over the column — the reference board's `TodoBoardGap`: an accent frame
// with a pale wash inside. Its stroke is **solid** where the reference draws a
// dash {4,3}, because this renderer's `Path` carries no dash array (checked
// against slint 1.18.1); the frame's job — a slot a card will fall into —
// survives the difference.
//
// Its height is grown from zero by the card that owns the seam rather than
// created on demand, because an element that appears cannot be animated into
// appearing and this slot is meant to *open*.
component OrgBoardGap inherits Rectangle {
    border-radius: Theme.radius-md;
    border-width: 1.5px;
    border-color: Colors.accent.with-alpha(0.80);
    background: Colors.accent.with-alpha(0.10);
}

// One column of the board: the list, its count, its open tasks, and the ＋ line
// that adds straight into it.
//
// The paint is the reference board's: a 2.8% wash of the ink over the page —
// barely there, which is the point; a column is a *place*, and a place that
// shouts is a place nobody scans — that deepens to 5.5% under the pointer and
// becomes a wash of the accent while a card is held over it. The width is a
// range, not a fixed 232: few columns share the spare width out (340 at the
// top), and many of them scroll instead of squeezing below 206.
component OrgBoardColumn inherits Rectangle {
    in property <BoardColumn> column;
    callback card-toggled(int);
    callback card-opened(int);
    callback added(string);
    // One draft per column would need one draft per column *id*; a single one is
    // shared because only one column's ＋ line can have focus at a time.
    property <string> add-draft: "";
    // The reference's ＋ is a **ghost line** that becomes an input when pressed —
    // a column of cards ends in a quiet verb, not in a boxed field asking for
    // text nobody is typing yet. This is whether that input is up.
    property <bool> adding: false;
    // The drop gap. The pointer's window y lives on the global (`org-drop-y`),
    // written by the drop area's `can-drop` on every drag-move; the gap slot
    // itself is drawn by whichever card's own range the pointer falls in (its
    // upper half → the slot above it, its lower half → the one below), which is
    // the same answer the reference's `dropIndexAt` computes from centers.
    // `gap-h` is its height — the reference's `max(si(34), card)`, at the floor
    // because this column's cards already know their own height and the slot is
    // a promise, not a preview.
    property <length> gap-h: 34px;
    private property <bool> drop-active: UIState.org-drop-list == column.id;
    // The list's own box, which is where the pointer has to be for a card to be
    // asking for a slot. The list's position comes from the column's layout
    // (padding, the header, the ＋ line) and not from how tall its delegates
    // turned out, so asking *it* is safe; asking a delegate used to not be — see
    // the note on the slot below.
    private property <length> list-top: list.absolute-position.y;
    private property <bool> over-list: root.drop-active
        && UIState.org-drop-y >= root.list-top
        && UIState.org-drop-y <= root.list-top + list.height;

    min-width: 206px;
    max-width: 340px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: drop-active
        ? Colors.accent.with-alpha(0.45)
        : ta.has-hover ? Colors.border.with-alpha(0.90) : Colors.border.with-alpha(0.55);
    background: drop-active
        ? Colors.accent.with-alpha(0.09)
        : Colors.text-primary.with-alpha(ta.has-hover ? 0.055 : 0.028);
    animate background { duration: Theme.duration-fast; }
    animate border-color { duration: Theme.duration-fast; }

    // Declared first, so it is *under* the column's own content: it exists for
    // `has-hover` only, and a hit area above the cards is a column nobody can
    // click into.
    ta := TouchArea { }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            if column.color >= 0 : Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2.5px;
                background: Colors.block-text(column.color);
            }
            Text {
                text: column.name;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                font-weight: Typography.weight-semibold;
                color: Colors.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: column.count;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        list := ListView {
            vertical-stretch: 1;
            // One item = one card *plus its 8 px gutter*, the gap the reference
            // sets between its cards (`spacing si(8)`), drawn the note list's way
            // because a `ListView` has no spacing of its own.
            //
            // The item height is **fixed**, and the slot is drawn over the cards
            // rather than opened between them. The reference slides the two cards
            // beside a real gap apart; here the item's height would have to feed
            // the list's layout, the layout feeds every item's
            // `absolute-position`, and `absolute-position` is the only thing that
            // knows which half of a card the pointer is in — a loop Slint answers
            // with "Recursion detected" instead of solving. So the card keeps its
            // seat and the slot is drawn on the *boundary* the reference's
            // `dropIndexAt` would have picked: the pointer in a card's upper half
            // opens the slot above it, in its lower half the one below, and the
            // frame straddles that edge — seventeen pixels either side — so it
            // reads as a seam being pulled open rather than a panel laid on top.
            // Reading `absolute-position` here is safe precisely because the
            // height above no longer depends on it.
            // The item's own extent, in window coordinates: its top, the line the
            // pointer has to cross to mean "above" it, and its foot. The 8 px in
            // the lower bound of `slot-above` is the gutter — a pointer resting in
            // the gutter is still on this card's leading seam, not on nobody's.
            for entry[i] in column.cards : Rectangle {
                property <length> my-top: self.absolute-position.y;
                property <length> my-mid: my-top + board-card.preferred-height / 2;
                property <length> my-foot: my-top + board-card.preferred-height;
                property <bool> slot-above: root.over-list
                    && (i == 0
                        ? UIState.org-drop-y < my-mid
                        : UIState.org-drop-y >= my-top - 8px && UIState.org-drop-y < my-mid);
                property <bool> slot-below: root.over-list && UIState.org-drop-y >= my-mid
                    && (i == column.cards.length - 1 || UIState.org-drop-y <= my-foot);
                height: board-card.preferred-height + 8px;
                board-card := OrgBoardCard {
                    y: 0;
                    card: entry;
                    toggled => { root.card-toggled(entry.id); }
                    opened => { root.card-opened(entry.id); }
                }
                // The two seams this card can open — the one above it and the one
                // below — are both always here and animate their own height, so
                // the slot *opens* over 150 ms the way the reference's does
                // instead of appearing between two frames. Growing a leaf's
                // height is safe where growing the item's was not: nothing lays
                // anything out from this box.
                OrgBoardGap {
                    y: -root.gap-h / 2;
                    width: parent.width;
                    height: slot-above ? root.gap-h : 0px;
                    opacity: slot-above ? 1.0 : 0.0;
                    animate height, opacity { duration: 150ms; easing: ease-out; }
                }
                OrgBoardGap {
                    y: self.height - 8px - root.gap-h / 2;
                    width: parent.width;
                    height: slot-below ? root.gap-h : 0px;
                    opacity: slot-below ? 1.0 : 0.0;
                    animate height, opacity { duration: 150ms; easing: ease-out; }
                }
            }
        }
        // The ＋ line, the reference's two shapes: a ghost verb at rest — muted,
        // left-aligned, invisible until the column holds it — and the one-line
        // input it turns into, committed by Enter or by the focus leaving, and
        // dismissed by Escape. The placeholder names the list, because a line
        // at the foot of 工作 that says 新任务 has not said where the task goes.
        if !root.adding : Rectangle {
            height: 28px;
            border-radius: Theme.radius-sm;
            background: add-ta.has-hover ? Colors.text-primary.with-alpha(0.07) : transparent;
            animate background { duration: Theme.duration-instant; }
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "＋ 添加任务";
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: add-ta.has-hover ? Colors.text-primary : Colors.text-muted;
                vertical-alignment: center;
            }
            add-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.adding = true;
                    root.add-draft = "";
                }
            }
        }
        if root.adding : Rectangle {
            height: 28px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: add-input.has-focus ? Colors.accent : Colors.border;
            background: Colors.surface-hover;
            if root.add-draft == "" : Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "新任务（" + column.name + "）";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            add-input := TextInput {
                x: 7px;
                y: 5px;
                width: parent.width - 14px;
                height: parent.height - 10px;
                text <=> root.add-draft;
                single-line: true;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-primary;
                vertical-alignment: center;
                selection-foreground-color: Colors.text-on-accent;
                selection-background-color: Colors.selection;
                accepted => {
                    if (root.add-draft != "") { root.added(root.add-draft); }
                    root.adding = false;
                    root.add-draft = "";
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.adding = false;
                        root.add-draft = "";
                        accept
                    } else {
                        reject
                    }
                }
                changed has-focus => {
                    // The focus leaving is the third of the reference's commits:
                    // a click anywhere else in the board sends the task rather
                    // than throwing it away — unless the text is empty, which no
                    // verb turns into a row.
                    if (!self.has-focus && root.add-draft != "") {
                        root.added(root.add-draft);
                    }
                    if (!self.has-focus) { root.adding = false; }
                }
                init => { add-input.focus(); }
            }
        }
    }
    // The drop target is last, so it is *above* the content: a `DropArea` only
    // reacts to a drag (normal clicks pass straight through).
    dropa := DropArea {
        can-drop(event) => {
            if (UIState.org-card-hover(event.data, column.id)) {
                // The pointer's window y, for the gap slot's arithmetic — the
                // event's own position is this area's, and the delegates read
                // `absolute-position` in the same coordinates.
                UIState.org-drop-y = event.position.y + self.absolute-position.y;
                DragAction.move
            } else {
                // A column that says no (its own card coming home) goes dark
                // *now* — the last accepted column's light would otherwise hang
                // around claiming a drop that is not going to happen.
                UIState.org-drop-list = -2;
                DragAction.none
            }
        }
        dropped(event) => {
            UIState.org-card-dropped(event.data, column.id);
            DragAction.move
        }
    }
}

// One text field of the detail pane. No border until it has focus, because a page
// of eight boxed fields is a form and this is a page.
component OrgInput inherits Rectangle {
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <length> font-size: Typography.size-ui;
    // NB: not `min-height` — that one is the layout's own property on a
    // `Rectangle`, and overriding it is an error.
    in property <length> hint-height: 28px;
    in-out property <string> value;
    // Whether the field takes the row's leftover width. A `Rectangle` has no
    // preferred width of its own, so this is min/max *plus* stretch — and **not**
    // an explicit `width`. An explicit width wins over the stretch, which is what
    // `width: root.grow ? 0px : root.field-width` did: every growing field in the
    // detail pane came out zero pixels wide, and the sweep photographed a task
    // with no title, no tags and no notes. (The fixed-width arm still wants it,
    // which is why min and max are both set there.)
    in property <bool> grow: true;
    in property <length> field-width: 170px;
    // Whether this is a **field** rather than a quiet row of the page. The search
    // box is one (`filled: true`, and the reference draws its `QLineEdit` with a
    // background too); the detail pane's inline title and the 标签 fields are
    // not, because a page of eight filled boxes is a form and this is a page.
    in property <bool> filled: false;
    // A quiet, inset surface for fields that belong to a floating editor.
    in property <bool> recessed: false;
    callback edited();
    callback accepted();

    min-width: root.grow ? 120px : root.field-width;
    max-width: root.grow ? 100000px : root.field-width;
    horizontal-stretch: root.grow ? 1 : 0;
    height: multiline
        ? max(root.hint-height, inner.preferred-height + 12px)
        : max(root.hint-height, 32px);
    border-radius: Theme.radius-sm;
    // A **field** is a field at rest, not on hover. The sort pill and the filter
    // chips are buttons and get a fill when the pointer is on them; a box you
    // are meant to click *into* and type in has to say so before the pointer
    // arrives, or the 笔记 toolbar's first control is an invisible rectangle with
    // the word 搜索笔记 floating in it. `surface-hover` is the reference's own
    // answer (`QLineEdit { background: %1; … }` with `glassBg(kColorBgElev)`),
    // and it is one step above the page rather than a border, so the field reads
    // as a field and the sort pill beside it still reads as a button.
    background: inner.has-focus ? Colors.background : Colors.surface;
    border-width: 1px;
    border-color: inner.has-focus ? Colors.accent
        : hover.has-hover ? Colors.border-strong : Colors.border;
    animate background { duration: Theme.duration-instant; }

    // Declared first, so it is *under* the text: it exists for the hover fill
    // only, and a TouchArea above an input is an input nobody can click into.
    hover := TouchArea { }
    // The placeholder. Slint's `TextInput` has none, and an empty field with no
    // hint is a field nobody knows what to type into. Also under the input, and
    // text takes no clicks of its own.
    if root.value == "" : Text {
        x: 8px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        text: root.placeholder;
        font-family: Typography.ui-font;
        font-size: root.font-size;
        color: Colors.text-muted;
        vertical-alignment: root.multiline ? top : center;
        overflow: elide;
    }
    inner := TextInput {
        x: 6px;
        y: 5px;
        width: parent.width - 12px;
        height: parent.height - 10px;
        text <=> root.value;
        wrap: root.multiline ? word-wrap : no-wrap;
        font-family: Typography.ui-font;
        font-size: root.font-size;
        color: Colors.text-primary;
        selection-foreground-color: Colors.text-on-accent;
        selection-background-color: Colors.selection;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

// The 笔记 half's sort box, the reference's `sortBox` (a 108 px combo with the
// three orders 最新创建 / 最新更新 / 按内容) drawn as a pill that opens its own
// list, because Slint has no combo box and a popup list is a second card on top
// of this one for three words.
//
// The pill is 108 px — the reference's own `setFixedWidth(si(108))` — and the
// chosen word is what it shows, not a label like 「排序」: a box that says
// 「排序」 and a list that says 「按内容」 is two clicks to learn the current
// order, and the current order is the thing the reader wants.
//
// The list hangs **under** the pill and is anchored to its own left edge, so it
// opens under the box the press was on; the reference's own combo does the same
// (QComboBox's view drops below the frame). It closes on the press that opened
// it, on Escape, and on a click outside — the last one is a `TouchArea` under the
// whole list rather than a "done" button, for the reason the settings dialog
// needed one (a popup only closable by its own button is a popup that outlives
// the user's attention).
component OrgSortBox inherits Rectangle {
    in property <[string]> labels: [];
    in property <int> selected: 0;
    in property <bool> open: false;
    // Where the list belongs, in **area** coordinates, so the area can draw it
    // outside the toolbar row.
    //
    // The list cannot be a child of the box: the box sits in a 30 px
    // `HorizontalLayout` row, and a layout gives a child only its own box to
    // paint in — so a list hanging 100 px below was clipped to a 30 px strip
    // (visible in the first `notes-sort` sweep: three blue slivers and no words).
    // Neither `clip` nor a bigger `height` on the box fixes it, because the clip
    // belongs to the *row*, not to the box. So the box reports where it is and
    // the area draws the list as one of **its own** last children — the same
    // reason the 指令 card and the capture layer are the area's last children.
    //
    // Reported in the area's coordinates rather than the window's, because the
    // area is what draws it and the area is what a `for` row's `parent` chain
    // ends in. `root.absolute-position` minus the area's own is the arithmetic;
    // doing it in the component would need the area's own position, which a
    // child cannot ask for.
    out property <length> list-x: 0px;
    out property <length> list-y: 0px;
    // The box cannot write the area's properties, so it *reports* where the
    // list belongs and the area stores it. The `+ 4px` is the gap between the
    // pill and the list — the reference's own combo view has it, and a list
    // flush against its box reads as part of the bar rather than as a popup over
    // the rows.
    callback report-position(length, length);
    // The open state belongs to the area above (it is that row's session state,
    // and a `bool` the box writes for itself would be a second copy of the same
    // fact). So the box *asks* rather than sets — the same rule the whole area
    // follows with `org-query`, `org-tab` and every other "how the user is
    // looking" value.
    callback opened();
    callback closed();
    callback picked(int);

    height: 30px;
    width: 108px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    // The reference draws its search box and sort box the same way: no border
    // until there is a reason for one — a fill on hover, the accent on focus.
    // A 1px border on both at rest made a toolbar of two boxes that read as two
    // form fields sitting in a row of buttons.
    border-color: root.open ? Colors.accent : Colors.border;
    background: root.open || ta.has-hover ? Colors.surface-hover : transparent;
    animate background { duration: Theme.duration-instant; }

    Text {
        x: 12px;
        width: parent.width - 12px - 18px;
        height: parent.height;
        text: root.labels[root.selected];
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: Colors.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    // The ▾, drawn rather than typed: `▾` is a Geometric Shapes glyph and this
    // app has no font chain that carries it (the `✕` trap, twice now).
    Rectangle {
        x: parent.width - 16px;
        y: (parent.height - 5px) / 2;
        width: 7px;
        height: 7px;
        clip: true;
        Path {
            x: 0;
            y: 0;
            width: 7px;
            height: 4px;
            viewbox-x: 0; viewbox-y: 0; viewbox-width: 7; viewbox-height: 4;
            stroke: Colors.text-muted; stroke-width: 1.2px;
            stroke-line-cap: round; stroke-line-join: round;
            fill: transparent;
            MoveTo { x: 0.6; y: 0.6; } LineTo { x: 3.5; y: 3.4; } LineTo { x: 6.4; y: 0.6; }
        }
    }
    // Declared before the list below, so the list's own hit area is above it.
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if (root.open) { root.closed(); } else { root.opened(); }
        }
    }

    // The list itself is `OrgSortList`, drawn by the area — see this component's
    // `report-position` for why it cannot live here.
    //
    // Reported from a **`changed` on the box's own geometry** rather than from
    // `init`, because a window resize moves the box without re-running `init` and
    // a one-shot report would leave the list anchored to the old width. The
    // position is in *window* coordinates and the area converts it, because a
    // child can read its own `absolute-position` but cannot read its parent's.
    changed absolute-position => {
        root.report-position(self.absolute-position.x, self.absolute-position.y);
    }
}

// The three orders, as a list that hangs under the pill — drawn by the **area**,
// not by the box, for the clipping reason `OrgSortBox`'s own comment gives. It
// is the same card as every other popup in this file (指令, the capture layer, a
// note's page): an offset shadow plate, a `border-strong` edge, and a clip.
component OrgSortList inherits Rectangle {
    in property <[string]> labels: [];
    in property <int> selected: 0;
    callback picked(int);
    callback closed();

    // 108 px, the pill's own width, so the two read as one control rather than as
    // a list that happens to be under a box.
    width: 108px;
    // Three rows of 28 px plus the 4 px of padding the reference's own combo view
    // carries (`QComboBox QAbstractItemView { … padding: 4px; }`).
    height: 3 * 28px + 8px;

    // The dismissal, and it is **first** so it is under the three rows: a press
    // on the box below the list closes it, and a press on a row picks it. A `z` of
    // -1 rather than a sibling above, because a sibling above would swallow the
    // rows it is meant to sit behind.
    miss := TouchArea {
        x: -600px;
        y: -600px;
        width: 1200px;
        height: 1200px;
        z: -1;
        mouse-cursor: MouseCursor.default;
        clicked => { root.closed(); }
    }
    // The shadow plate, drawn the way `ContextMenu` and the 悬浮 ＋ draw theirs:
    // this renderer has no drop-shadow, so it is an offset plate behind the card.
    Rectangle {
        x: 1px;
        y: 2px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Theme.radius-md;
        background: Colors.shadow;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Colors.border-strong;
        background: Colors.surface-overlay;
        clip: true;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            for entry[i] in root.labels : Rectangle {
                height: 28px;
                border-radius: Theme.radius-xs;
                // A selected order is a **state**, not an emphasis, and this
                // component's own comment about it was being contradicted by the
                // colour: `surface-selected` is `bg-elev2.mix(accent, 0.22)`, a
                // saturated blue plate, which is the one thing ADR-0118 removed
                // from the filter chips for exactly this reason. The lit row is a
                // raised surface with the text in the primary colour, and the
                // accent keeps its job.
                background: item-ta.has-hover
                    ? Colors.hover-fill
                    : (root.selected == i ? Colors.surface-hover : transparent);
                animate background { duration: Theme.duration-instant; }
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: entry;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    // The lit row is a *state*, not an emphasis, for the reason
                    // `OrgFilterChip` states: the order is on by default and a
                    // saturated plate for it is a shout about the one thing the
                    // user already knows.
                    color: root.selected == i
                        ? Colors.text-primary : Colors.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                item-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.picked(i);
                        root.closed();
                    }
                }
            }
        }
    }
}

// The area's empty state. The prototype's own shape (icon / one line of diagnosis
// / one line of remedy / a button), and the diagnosis is **per filter**: a reader
// with ninety notes and an empty list wants to know which of the three doors is
// shut, and the button has to open that one rather than a different one.
//
// Drawn only for an empty *result*, never for an empty *library* — the two say so
// in different words below, and `filtered` is what tells them apart.
component OrgEmptyState inherits VerticalLayout {
    in property <bool> filtered: false;

    alignment: center;
    spacing: 8px;

    // The emoji, asked for by name rather than left to fall back: this is the
    // one place a colour emoji is the whole message, and Segoe UI carries
    // monochrome glyphs for the same code points.
    Text {
        text: "📝";
        font-family: Typography.emoji-font;
        font-size: 40px;
        horizontal-alignment: center;
    }
    Text {
        text: !root.filtered ? "这里还没有笔记"
            : UIState.org-tag != "" ? "当前筛选下没有笔记"
            : UIState.org-excluded-label != "" ? "排除之后没有剩余笔记"
            : "没有匹配的笔记";
        font-family: Typography.ui-font;
        font-size: Typography.size-ui-lg;
        font-weight: Typography.weight-semibold;
        color: Colors.text-secondary;
        horizontal-alignment: center;
    }
    Text {
        max-width: 340px;
        text: !root.filtered ? "点击右下角 ＋ 记录第一条。"
            : UIState.org-tag != "" ? "#" + UIState.org-tag + " 可能挂在别的层级下。"
            : UIState.org-excluded-label != "" ? "所有笔记都带着被排除的标签。"
            : "换个关键词，或者搜标签名（#工作）。";
        font-family: Typography.ui-font;
        font-size: 12.5px;
        color: Colors.text-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    // The button is the door the empty list is behind: 清除筛选 for a filter that
    // matched nothing, 新建一条笔记 for a library that really is empty. The two
    // `OrgButton`s are one row because a VerticalLayout would stretch either to
    // the column's whole width, and a full-width button is a bar, not a door.
    HorizontalLayout {
        height: 34px;
        padding-top: 6px;
        Rectangle { horizontal-stretch: 1; }
        if root.filtered : OrgButton {
            label: "清除筛选";
            accent: true;
            clicked => { UIState.org-filters-cleared(); }
        }
        if !root.filtered : OrgButton {
            label: "新建一条笔记";
            accent: true;
            clicked => { UIState.org-capture-opened(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// ── the 笔记 stream (the 2026-10-19 prototype) ───────────────────────────────
//
// The prototype's middle column is a *stream*, not a stack of cards: a title line
// that says what is showing, one row of tools, and rows that carry no border
// until the pointer or a selection gives them one. The five components below are
// the vocabulary that shape needed and this file did not have — everything else
// (`OrgPill`, `OrgCheck`, `OrgSortBox`, `OrgButton`) was already here.

// The list's own search field: a magnifier inside the box and a ✕ that exists
// only once there is something to clear. `OrgInput` is the detail pane's field —
// a plain rectangle with no adornment — and a needle is a control you click
// *into*, so it says so at rest: a fill, a glyph, a hint.
component OrgNeedle inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    callback edited();

    min-width: 96px;
    max-width: 100000px;
    horizontal-stretch: 1;
    height: 32px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: inner.has-focus ? Colors.accent : Colors.border;
    background: inner.has-focus ? Colors.background : Colors.surface-hover;
    animate border-color { duration: Theme.duration-instant; }

    Icon {
        x: 10px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        size: 14px;
        name: "search";
        color: inner.has-focus ? Colors.accent-text : Colors.text-muted;
    }
    if root.value == "" : Text {
        x: 30px;
        y: 0px;
        width: parent.width - 30px - 10px;
        height: parent.height;
        text: root.placeholder;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }
    inner := TextInput {
        x: 30px;
        y: 5px;
        width: parent.width - 30px - (root.value != "" ? 30px : 10px);
        height: parent.height - 10px;
        single-line: true;
        text <=> root.value;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-primary;
        selection-foreground-color: Colors.text-on-accent;
        selection-background-color: Colors.selection;
        edited => { root.edited(); }
    }
    // The clear. It is a drawn `x` icon in a plate, not the character ✕ — U+2715
    // is Dingbats and this app's font chain carries no glyph for it, which makes a
    // `Text` of it an invisible control whose TouchArea still answers. It sits
    // outside the field's own width, so it never covers the caret.
    if root.value != "" : Rectangle {
        x: parent.width - 26px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: clear-ta.has-hover ? Colors.surface-selected : transparent;
        Icon {
            x: 3px;
            y: 3px;
            width: 12px;
            height: 12px;
            size: 12px;
            name: "x";
            color: Colors.text-muted;
        }
        clear-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.value = "";
                root.edited();
            }
        }
    }
}

// A tool in the list's toolbar row: an icon, a word, a 30 px plate. The words are
// what the icon-only row this replaces lacked — 多选 / 指令 / 复制 should not have
// to be remembered from their glyphs, and a labelled pill is also a wider hit
// area than a 40 px square of nothing.
component OrgTool inherits Rectangle {
    in property <string> label;
    in property <string> icon-name: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    width: box.preferred-width;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Colors.accent.with-alpha(0.35)
        : ta.has-hover ? Colors.border-strong : Colors.border;
    background: root.selected ? Colors.accent.with-alpha(0.08)
        : ta.has-hover ? Colors.hover-fill : Colors.surface;
    animate background { duration: Theme.duration-instant; }
    animate border-color { duration: Theme.duration-instant; }

    box := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;
        if root.icon-name != "" : Icon {
            width: 14px;
            height: 14px;
            size: 14px;
            name: root.icon-name;
            color: root.selected ? Colors.accent-text
                : root.danger ? Colors.danger : Colors.text-muted;
        }
        if root.label != "" : Text {
            text: root.label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: root.selected ? Colors.accent-text
                : root.danger ? Colors.danger : Colors.text-secondary;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A day-section header: the word, its count, and a hairline that runs to the
// column's right edge. The prototype's `.group-label` — a stream needs a floor
// under each day, and a bare word over a list of borderless rows is not one.
component OrgSectionHead inherits Rectangle {
    in property <string> label;
    in property <int> count: 0;

    height: 26px;
    head-text := Text {
        x: 0px;
        y: 0px;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: 11.5px;
        font-weight: Typography.weight-semibold;
        letter-spacing: 0.6px;
        color: Colors.text-muted;
        vertical-alignment: center;
    }
    if root.count > 0 : Text {
        x: head-text.width + 8px;
        y: 0px;
        height: parent.height;
        text: root.count;
        font-family: Typography.mono-font;
        font-size: 10.5px;
        color: Colors.text-muted;
        vertical-alignment: center;
    }
    Rectangle {
        x: head-text.width + (root.count > 0 ? 52px : 12px);
        y: (parent.height - 1px) / 2;
        width: parent.width - self.x;
        height: 1px;
        background: Colors.divider;
    }
}

// One note in the stream. The row carries **no border at rest**: a list of
// bordered cards makes forty frames out of forty notes, and the prototype's row
// is a place the pointer lights up. A picked or highlighted row gets three cues at
// once — an accent wash, an accent hairline, and a 3 px bar outside its left edge —
// because a tint alone disappears against the page it sits on.
//
// The row's own `TouchArea` is its **first** child. It used to be its last, which
// put the whole card above its own tag pills: a pill under the row's hit area is a
// pill that filters nothing, and `#读书` on a note silently did nothing.
component OrgNoteRow inherits Rectangle {
    in property <NoteRow> note;

    callback opened();
    callback menu-requested(length, length);
    callback restored();
    callback purged();

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: note.selected || note.picked ? Colors.accent.with-alpha(0.35)
        : row-ta.has-hover ? Colors.border : transparent;
    background: note.selected || note.picked ? Colors.accent.with-alpha(0.08)
        : row-ta.has-hover ? Colors.surface-hover : transparent;
    animate background { duration: Theme.duration-instant; }
    animate border-color { duration: Theme.duration-instant; }

    row-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        // **Selects, and stops there** (ADR-0137): raising the note page on every
        // click made a list of notes impossible to scan. The page is the menu's
        // 打开, and the row's ⋯ is the same door with a button on it.
        clicked => { root.opened(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.right
                && !UIState.org-bin-open
                && !UIState.org-selecting) {
                // Anchored to the row's right edge, so the menu opens in the same
                // place whichever of the two doors the press came through.
                root.menu-requested(
                    self.absolute-position.x + self.width,
                    self.absolute-position.y);
            }
        }
    }
    if note.selected || note.picked : Rectangle {
        x: -4px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: Colors.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        // `start`, not `center`: the time column and the pick box both hang at the
        // first line of the note's text, which is what lets a stream be read down
        // one left edge.
        cross-axis-alignment: start;

        if UIState.org-selecting : OrgCheck {
            box-size: 18px;
            checked: note.picked;
            // The same route as the row itself: while picking, both mean "this one".
            toggled => { root.opened(); }
        }
        // The time column: fixed, mono, right-aligned. 72 px rather than the
        // prototype's 56, because this app answers a note older than a month with a
        // full ISO date and 56 px elides it to "2026-0…".
        Text {
            width: 72px;
            height: 18px;
            text: note.when;
            font-family: Typography.mono-font;
            font-size: 11px;
            color: Colors.text-muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 60px;
            max-width: 100000px;
            spacing: 2px;

            if note.title != "" : HorizontalLayout {
                height: 20px;
                spacing: 6px;
                cross-axis-alignment: center;
                Text {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    max-width: 100000px;
                    text: note.title;
                    font-family: Typography.ui-font;
                    font-size: 13.5px;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if note.pinned : Icon {
                    width: 12px;
                    height: 12px;
                    size: 12px;
                    name: "star";
                    color: Colors.accent-text;
                }
            }
            // The note's first line, clamped to two. Rust hands over the excerpt
            // (`org_note_row`) because *which* line opens a note is a decision about
            // the body, and 按内容 sorts on exactly this text — a row that showed a
            // different line would be a list ordered by something it does not draw.
            if note.excerpt != "" : Text {
                height: min(self.preferred-height, 40px);
                text: note.excerpt;
                font-family: Typography.ui-font;
                font-size: 12.5px;
                color: Colors.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
            // A row a ＋ was pressed on and left alone: one muted line rather than
            // an empty box, which is what the reference draws as （空笔记）.
            if note.title == "" && note.excerpt == "" : Text {
                height: 20px;
                text: "空笔记";
                font-family: Typography.ui-font;
                font-size: 12.5px;
                color: Colors.text-muted;
                vertical-alignment: center;
            }
            if note.tag-list.length > 0 : HorizontalLayout {
                height: 23px;
                padding-top: 5px;
                spacing: 6px;
                for tag[i] in note.tag-list : OrgPill {
                    text: "#" + tag;
                    value: tag;
                    // The tag's own colour, one slot per path out of Rust — the same
                    // slot the rail's row for this tag draws, so a note's pill and
                    // the filter it points at are visibly the same thing.
                    tint: Colors.block-text(note.tag-slots[i]);
                    clickable: true;
                    picked(t) => { UIState.org-tag-picked(t); }
                }
            }
        }
        // The row's doors, in their own columns rather than floated over the text:
        // an ⋯ that appears on hover at `right: 10px` also covers the last tag chip
        // of every row it hovers, and a chip you cannot click is the bug this
        // component's hit areas were written against.
        if !UIState.org-selecting && !UIState.org-bin-open : IconButton {
            icon-name: "dots-horizontal";
            icon-color: Colors.text-muted;
            size: 26px;
            clicked => {
                root.menu-requested(self.absolute-position.x, self.absolute-position.y);
            }
        }
        // 回收站: a binned row's own two verbs. Drawn in the row and not in a menu,
        // because the bin is a short list of things the user came to decide about
        // one at a time — and every verb outside these two writes to a note that is
        // on no list.
        if UIState.org-bin-open : OrgButton {
            label: "恢复";
            font-size: Typography.size-caption;
            clicked => { root.restored(); }
        }
        if UIState.org-bin-open : OrgButton {
            label: "彻底删除";
            font-size: Typography.size-caption;
            danger: true;
            clicked => { root.purged(); }
        }
    }
}

// One number and the word under it (近 7 天 / 标签). A *card* rather than a line,
// because the rest of the rail is places to click, and a stat that looks like a nav
// row is a stat nobody can find.
component OrgStatCard inherits Rectangle {
    in property <int> value;
    in property <string> label;

    min-width: 56px;
    max-width: 100000px;
    horizontal-stretch: 1;
    height: 50px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Colors.border;
    background: Colors.surface;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 8px;
        spacing: 0px;
        Text {
            text: root.value;
            font-family: Typography.mono-font;
            font-size: 18px;
            font-weight: Typography.weight-bold;
            color: Colors.accent-text;
        }
        Text {
            text: root.label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
            overflow: elide;
        }
    }
}

// The rail's block title, with its count at the far edge: 概览 8 篇 / 标签 5.
// Letterspaced and small because it labels a *block*; the rows under it are what
// the eye actually reads.
component OrgRailTitle inherits Rectangle {
    in property <string> label;
    in property <string> count: "";

    height: 20px;
    Text {
        x: 6px;
        y: 0px;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: 10.5px;
        font-weight: Typography.weight-semibold;
        letter-spacing: 1px;
        color: Colors.text-muted;
        vertical-alignment: center;
    }
    if root.count != "" : Text {
        x: 6px;
        y: 0px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.count;
        font-family: Typography.mono-font;
        font-size: 10.5px;
        color: Colors.text-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component OrganizerArea inherits Rectangle {
    vertical-stretch: 1;
    max-height: 100000px;
    in-out property <bool> task-more-open: false;
    in-out property <bool> note-replies-open: false;
    // Detail panels start compact; the narrow grip between list and detail lets
    // the reader choose more room when a particular task or note needs it.
    in-out property <length> detail-panel-width: 400px;
    in-out property <length> detail-panel-grab-x: 0px;
    in-out property <length> detail-panel-start-width: 400px;
    in-out property <bool> detail-panel-resizing: false;
    in property <int> selected-task-id: UIState.org-task-detail.id;
    in property <int> selected-note-id: UIState.org-note-detail.id;
    changed selected-task-id => { root.task-more-open = false; }
    changed selected-note-id => { root.note-replies-open = false; }
    // Transparent for the same reason as the editor: the window's `Colors.page`
    // ramp is the backdrop, so the gradient runs behind the organizer too.
    background: Colors.background;
    // `horizontal-stretch` alone does **not** grow this area, and the reason is
    // worth the two lines: a `Rectangle` whose content is a layout takes its
    // `max-width` from that layout's preferred width, so the stretch factor has
    // no room above the ceiling to distribute. With the ceiling left alone the
    // area came out 885 px wide (its own 208 + 1 + rows + 1 + 340), the 340 px
    // detail panel started at x = 677, the list beside it was squeezed to 239 px,
    // and every task title elided to "今天…". The editor never showed it because
    // its preferred width is already the width of the window.
    //
    // This is the same rule `OrgInput` learned for its growing fields: min/max
    // *plus* stretch. Everything that has to take the leftover width here says
    // it the same way.
    horizontal-stretch: 1;
    max-width: 100000px;

    // Whether the notes toolbar's tools get their words. `AppShell` answers it from
    // the *window's* width: this area's own `width` is computed from what its
    // children ask for, so a tool that hid its label to fit would be deciding its
    // own size, and Slint calls that a binding loop. Under the threshold the tools
    // keep their glyphs and drop their words — a squeezed tool is still a tool, a
    // clipped one is a button nobody can press.
    in property <bool> tools-worded: true;

    // The chips' own words, in Rust's slot order: the smart views
    // (`State::SMART_*`) and the repeat rules (`Repeat::ALL`). Names live here
    // because they are the UI's words; the *predicate* behind a smart view is
    // Rust's, and the *slot* is what the two sides agree on.
    // 已完成 is deliberately not in this list: it is the nav's bottom row, so the
    // four above it are the views a task can be *in*.
    property <[string]> smart-names: ["收集箱", "今天", "最近 7 天", "全部"];
    property <[string]> priority-names: ["无", "低", "中", "高"];
    property <[string]> repeat-names: ["不重复", "每天", "工作日", "每周", "每月"];
    property <[string]> sort-names: ["添加顺序", "优先级", "截止日期"];
    // The 笔记 half's three orders, the reference's `sortBox` items in its own
    // order (`setItemData(0..2)` = created / updated / content). Its own list
    // beside the tasks' because the two halves' orders have nothing in common.
    property <[string]> note-sort-names: ["最新创建", "最新更新", "按内容"];
    // Where the sort list hangs, in this area's own coordinates. Written by the
    // `OrgSortBox` in the bar and read by the `OrgSortList` at the bottom of this
    // component; a property rather than a binding because the two are in
    // different sub-trees and neither is the other's parent.
    out property <length> note-sort-x: 0px;
    out property <length> note-sort-y: 0px;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ── the one card ───────────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            max-height: 100000px;
            horizontal-stretch: 1;
            max-width: 100000px;
            background: transparent;

            HorizontalLayout {
                spacing: 0px;

                // ── the list column (or the board) ──────────────────────────
                if UIState.org-tab != 0 || UIState.org-note-detail.id < 0 : Rectangle {
                    min-width: 280px;
                    preferred-width: 380px;
                    max-width: 100000px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    max-height: 100000px;
                    background: Colors.surface;
                    clip: true;

                    VerticalLayout {
                        // 20 / 20 / 16 / 16 — the reference's own list metrics, and
                        // the number that made these cards read as the reference's:
                        // `listLay->setContentsMargins(si(20), 0, si(20), si(16))`
                        // for the list and `toolbar->setContentsMargins(si(20),
                        // si(16), si(16), si(12))` for the header above it. The two
                        // are merged into one padding because the header and the
                        // cards must share a left edge: at 14 px the cards were
                        // inset further than the title and the count, so the
                        // header read as a row of chrome sitting *beside* the list
                        // rather than as its own top.
                        //
                        // With the card's own 14 px inside, a note's first glyph
                        // lands 34 px from the column's edge — which is exactly
                        // where the reference's lands (20 + 14), and the reason
                        // its cards look like cards in a column rather than like
                        // rows with a border drawn round them.
                        padding-left: 20px;
                        padding-right: 20px;
                        // 16 on both halves. The 笔记 half used to carry 88 px here
                        // because its toolbar floated *over* the column, and the
                        // column had to leave a hole for it — which is why the first
                        // card vanished under the bar the moment the two numbers
                        // disagreed. The bar is a row of this layout now.
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 10px;

                        // the header: what is showing, how many, and the two
                        // ways of looking at it. While 多选 is on, the bar in
                        // SPEC §四十一 / ADR-0111 replaces this row entirely — the
                        // view's title and its counts are not the question being
                        // asked any more.
                        if !UIState.org-selecting && UIState.org-tab != 0 : VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                height: 32px; spacing: 8px;
                                Text {
                                    text: UIState.org-tab == 0 ? "笔记" : "任务";
                                    font-size: 20px; font-family: Typography.ui-font;
                                    font-weight: 600; color: Colors.text-primary;
                                }
                                Text { text: UIState.org-view-count-label; font-size: Typography.size-caption; color: Colors.text-muted; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                IconButton { icon-name: "refresh"; icon-color: Colors.text-muted; hover-color: Colors.accent-text; clicked => { UIState.sync-now-all(); } }
                                IconButton { icon-name: "todo-check"; clicked => { UIState.org-select-entered(UIState.org-tab); } }
                                IconButton { icon-name: "dots-horizontal"; clicked => { UIState.org-command-opened(UIState.org-tab); } }
                                if UIState.org-tab == 0 : IconButton { icon-name: "copy"; clicked => { UIState.org-notes-copy-all(); } }
                            }
                            HorizontalLayout {
                                height: 32px; spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1; min-width: 100px; max-width: 100000px;
                                    border-radius: Theme.radius-sm; border-width: 1px;
                                    border-color: Colors.border; background: Colors.background;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 8px; spacing: 8px;
                                        Text { text: UIState.org-view-title; horizontal-stretch: 1; overflow: elide; font-family: Typography.ui-font; font-size: Typography.size-ui; color: Colors.text-primary; vertical-alignment: center; }
                                        if UIState.org-tab == 1 : Icon { name: "chevron-down"; width: 14px; height: 14px; size: 14px; color: Colors.text-muted; }
                                    }
                                    if UIState.org-tab == 1 : TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { filter-menu.show(); } }
                                }
                                if UIState.org-tab == 1 && !UIState.org-bin-open : OrgSeg {
                                    selected: UIState.org-mode;
                                    picked(m) => { UIState.org-mode-picked(m); }
                                }
                            }
                        }

                        // ── the 笔记 half's header (the 2026-10-19 stream) ──────
                        //
                        // The title, its count and the filters that produced them,
                        // then one row of tools. The prototype's `.listhead` and
                        // `.listtoolbar`, and the replacement for the 72 px bar that
                        // used to float over this column: a floating bar needed 88 px
                        // of reserved padding, hid the first card whenever the two
                        // numbers disagreed, could not hold a title without covering a
                        // row, and was invisible to the layout above it — so 多选,
                        // whose bar sits *in* this column, used to draw underneath it.
                        if UIState.org-tab == 0 && !UIState.org-selecting : VerticalLayout {
                            spacing: 0px;

                            // `.listhead` — 17 px, a mono count, and the doors that
                            // explain the count at the far edge.
                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                // `end`: the count hangs on the title's baseline,
                                // which is what makes the pair read as one number
                                // attached to one word rather than two texts.
                                cross-axis-alignment: end;
                                Text {
                                    // The prototype's own three answers, read off the
                                    // three filters: a needle in, a tag picked, the bin
                                    // open. 搜索结果 first, because a reader who typed
                                    // is asking whether the box did anything.
                                    text: UIState.org-query != "" ? "搜索结果"
                                        : UIState.org-view-title;
                                    font-family: Typography.display-font;
                                    font-size: 17px;
                                    font-weight: Typography.weight-bold;
                                    color: Colors.text-primary;
                                    vertical-alignment: bottom;
                                    overflow: elide;
                                }
                                Text {
                                    // The rows under this line, read off the model
                                    // that draws them — the same source the 全选
                                    // button counts against. Rust's own
                                    // `org-view-count-label` is the same number; this
                                    // one is bare because a heading already says what
                                    // is being counted.
                                    text: UIState.note-rows.length + " 篇";
                                    font-family: Typography.mono-font;
                                    font-size: Typography.size-caption;
                                    color: Colors.text-muted;
                                    vertical-alignment: bottom;
                                    height: 22px;
                                }
                                Rectangle { horizontal-stretch: 1; min-width: 0px; max-width: 100000px; }
                                // The filter line, and one door out of all three
                                // filters at once. It only exists when a filter is on:
                                // a 清除 that clears nothing is noise beside a title.
                                if UIState.org-query != "" || UIState.org-tag != ""
                                    || UIState.org-excluded-label != "" : HorizontalLayout {
                                    height: 26px;
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    if UIState.org-query != "" : Text {
                                        text: "“" + UIState.org-query + "”";
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-secondary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if UIState.org-tag != "" : Text {
                                        text: "#" + UIState.org-tag;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.accent-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if UIState.org-excluded-label != "" : Text {
                                        text: UIState.org-excluded-label;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.danger;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    OrgButton {
                                        label: "清除筛选";
                                        accent: true;
                                        font-size: Typography.size-caption;
                                        clicked => { UIState.org-filters-cleared(); }
                                    }
                                }
                                // 同步, and the one tap that runs it now. The status
                                // used to sit at the far edge of the floating bar,
                                // where it read as part of the window's chrome rather
                                // than as an answer about *these* rows.
                                sync-pill := Rectangle {
                                    height: 26px;
                                    width: sync-row.preferred-width;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: sync-ta.has-hover ? Colors.border-strong : Colors.border;
                                    background: sync-ta.has-hover ? Colors.hover-fill : transparent;
                                    animate background { duration: Theme.duration-instant; }
                                    sync-row := HorizontalLayout {
                                        x: 0px;
                                        y: 0px;
                                        width: self.preferred-width;
                                        height: parent.height;
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: UIState.sync-has-peers
                                                ? Colors.success : Colors.text-muted;
                                        }
                                        Text {
                                            text: UIState.sync-has-peers ? "已配置同步" : "未配置同步";
                                            font-family: Typography.ui-font;
                                            font-size: Typography.size-caption;
                                            color: UIState.sync-has-peers
                                                ? Colors.accent-text : Colors.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                    sync-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { UIState.sync-now-all(); }
                                    }
                                }
                            }

                            // `.listtoolbar` — the needle, the order, the doors. The
                            // tools have words on them now: 多选 / 指令 / 复制 are three
                            // dots-and-boxes otherwise, and the row this replaces was
                            // the one place in the area a reader had to remember which
                            // glyph did what.
                            HorizontalLayout {
                                height: 42px;
                                padding-top: 6px;
                                // 6, not the area's usual 8: at the window's 940 px
                                // floor the row's seven parts have 424 px between
                                // them, and two px of gap each is what decides
                                // whether the last tool is on screen.
                                spacing: 6px;
                                cross-axis-alignment: center;
                                IconButton {
                                    icon-name: "panel-left";
                                    size: 30px;
                                    icon-color: Colors.text-muted;
                                    clicked => { UIState.toggle-sidebar(); }
                                }
                                OrgNeedle {
                                    placeholder: "搜索笔记…";
                                    value <=> UIState.org-query;
                                    edited => { UIState.org-query-changed(); }
                                }
                                // 排序 and its direction, and neither in the bin: a
                                // binned list's order is not a question anyone asks,
                                // and 回收站's list is short enough to read whole.
                                if !UIState.org-bin-open : OrgSortBox {
                                    labels: root.note-sort-names;
                                    selected: UIState.org-note-sort;
                                    open: UIState.org-note-sort-open;
                                    report-position(x, y) => {
                                        root.note-sort-x = x - root.absolute-position.x;
                                        root.note-sort-y = y - root.absolute-position.y
                                        + 30px + 4px;
                                    }
                                    opened => { UIState.org-note-sort-open = true; }
                                    picked(slot) => {
                                        UIState.org-note-sort-open = false;
                                        UIState.org-note-sort-picked(slot);
                                    }
                                    closed => { UIState.org-note-sort-open = false; }
                                }
                                if !UIState.org-bin-open : IconButton {
                                    icon-name: UIState.org-note-descending ? "chevron-down" : "chevron-up";
                                    size: 30px;
                                    icon-color: Colors.text-muted;
                                    clicked => { UIState.org-note-sort-direction-toggled(); }
                                }
                                if UIState.org-bin-open : OrgTool {
                                    label: root.tools-worded ? "清空回收站" : "";
                                    icon-name: "trash";
                                    danger: true;
                                    clicked => { UIState.org-bin-emptied(); }
                                }
                                OrgTool {
                                    label: root.tools-worded ? "多选" : "";
                                    icon-name: "todo-check";
                                    clicked => { UIState.org-select-entered(0); }
                                }
                                OrgTool {
                                    label: root.tools-worded ? "指令" : "";
                                    icon-name: "dots-horizontal";
                                    clicked => { UIState.org-command-opened(0); }
                                }
                                OrgTool {
                                    label: root.tools-worded ? "复制全部" : "";
                                    icon-name: "copy";
                                    clicked => { UIState.org-notes-copy-all(); }
                                }
                            }
                        }

                        if !UIState.org-selecting && UIState.org-tab != 0 : HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            if UIState.org-bin-open : OrgButton { label: "清空回收站"; danger: true; font-size: Typography.size-caption; clicked => { UIState.org-bin-emptied(); } }
                        }

                        // 多选's own bar, in the column rather than floating over
                        // it. On the 笔记 half the bar *is* the page while picking —
                        // the prototype's `.batchbar`: an accent wash, an accent
                        // hairline, the count in mono. 任务 keeps the plain 30 px row
                        // it had, which is why every number below reads `org-tab`.
                        if UIState.org-selecting : Rectangle {
                            height: UIState.org-tab == 0 ? 40px : 30px;
                            border-radius: Theme.radius-md;
                            border-width: UIState.org-tab == 0 ? 1px : 0px;
                            border-color: Colors.accent.with-alpha(0.35);
                            background: UIState.org-tab == 0
                                ? Colors.accent.with-alpha(0.08) : transparent;
                            HorizontalLayout {
                                padding-left: UIState.org-tab == 0 ? 10px : 0px;
                                padding-right: UIState.org-tab == 0 ? 6px : 0px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                // The count first, and it is one line rather than the
                                // view's title: while picking, "how many have I got"
                                // is the only heading that means anything.
                                Text {
                                    text: "已选 " + UIState.org-selection-count + " 项";
                                    font-family: UIState.org-tab == 0
                                        ? Typography.mono-font : Typography.ui-font;
                                    font-size: Typography.size-ui-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: UIState.org-tab == 0
                                        ? Colors.accent-text : Colors.text-primary;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            // 全选 or 取消全选, read off the two numbers the models
                            // already carry: the set's size against the rows on
                            // screen. Which of the two this is stays Rust's call.
                            OrgButton {
                                label: UIState.org-selection-count > 0
                                    && UIState.org-selection-count >= (UIState.org-tab == 0
                                        ? UIState.note-rows.length
                                        : UIState.task-rows.length)
                                    ? "取消全选" : "全选";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-select-all-toggled(); }
                            }
                            // 复制 is both halves': the notes send their bodies with
                            // their 唯一 IDs, the tasks their titles and 备注 with the
                            // same — the ID is what lets the answer name the row.
                            OrgButton {
                                label: "复制";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-selection-verbed(0); }
                            }
                            if UIState.org-tab == 1 : OrgButton {
                                label: "完成";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-selection-verbed(1); }
                            }
                            OrgButton {
                                label: "删除";
                                font-size: Typography.size-caption;
                                danger: true;
                                clicked => { UIState.org-selection-verbed(2); }
                            }
                                OrgButton {
                                    // Drawn, not typed: see OrgButton's `icon-name`.
                                    icon-name: "x";
                                    clicked => { UIState.org-select-stopped(); }
                                }
                            }
                        }

                        // The hairline under the 任务 header. Not under 笔记's, whose
                        // header ends in a row of tools and whose stream opens with
                        // its own day label: a rule between the two is a line drawn
                        // across a page that is already in blocks.
                        if UIState.org-tab != 0 : Rectangle { height: 1px; background: Colors.border; }
                        // 回收站 is a mode *over* the list, so it takes the list's
                        // branch whatever 列表/平铺 says: a bin is not a kanban, and
                        // the board draws no binned cards anyway (`org_board_rows`
                        // reads the live half).
                        if UIState.org-tab == 1 && (UIState.org-mode == 0 || UIState.org-bin-open) : VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            // Adding into a bin and sorting one are both questions
                            // about a *list*, so neither is offered while the bin is
                            // open — the row is there for the list it belongs to.
                            if !UIState.org-bin-open : OrgQuickAdd {
                                placeholder: "添加任务到「" + UIState.org-view-title + "」…";
                                value <=> UIState.org-quick-add;
                                submitted => { UIState.org-quick-add-submitted(); }
                            }

                            if !UIState.org-bin-open : HorizontalLayout {
                                height: 24px;
                                spacing: 4px;
                                OrgField { name: "排序"; width: 28px; }
                                for name[i] in root.sort-names : OrgButton {
                                    label: name;
                                    font-size: Typography.size-caption;
                                    selected: UIState.org-sort == i;
                                    clicked => { UIState.org-sort-picked(i); }
                                }
                                OrgButton {
                                    label: UIState.org-task-descending ? "倒序" : "顺序";
                                    font-size: Typography.size-caption;
                                    clicked => { UIState.org-task-sort-direction-toggled(); }
                                }
                            }

                            ListView {
                                vertical-stretch: 1;
                                for entry[i] in UIState.task-rows : Rectangle {
                                    height: task-item.height + 8px;
                                    task-item := OrgTaskRow {
                                        x: 1px; y: 0px;
                                        width: parent.width - 2px;
                                        task: entry;
                                        toggled => { UIState.org-task-done-toggled(entry.id); }
                                        opened => { UIState.org-task-selected(entry.id); }
                                        menu-requested(x, y) => {
                                            UIState.org-task-menu-requested(entry.id, x, y);
                                        }
                                    }
                                }
                            }

                            // the footer: the switch that reveals the finished
                            // ones, and the whole area's progress
                            Rectangle {
                                height: 34px;
                                Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width;
                                    background: Colors.divider;
                                }
                                HorizontalLayout {
                                    height: parent.height;
                                    spacing: 8px;
                                    OrgButton {
                                        label: (UIState.org-show-done ? "隐藏已完成 (" : "显示已完成 (")
                                            + UIState.org-done-count + ")";
                                        clicked => { UIState.org-show-done-toggled(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "已完成 " + UIState.org-done-count + " / "
                                            + UIState.org-total-count;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ── 平铺: one column per list ──────────────────────
                        if UIState.org-tab == 1 && UIState.org-mode == 1 && !UIState.org-bin-open : ScrollView {
                            vertical-stretch: 1;
                            HorizontalLayout {
                                spacing: 12px;
                                for col[i] in UIState.org-board : OrgBoardColumn {
                                    column: col;
                                    card-toggled(id) => { UIState.org-task-done-toggled(id); }
                                    card-opened(id) => { UIState.org-task-selected(id); }
                                    added(title) => { UIState.org-task-add-to(col.id, title); }
                                }
                                Rectangle { width: 1px; }
                            }
                        }

                        // ── 笔记 ───────────────────────────────────────────
                        // A card in the reference app's own order, which is what a
                        // note is *read* by: the age first, at the top-left, with
                        // the pin beside it and the row's ⋯ at the right edge; the
                        // note's own words under that; its tags last (ADR-0115).
                        // The old shape led with the title and buried the age on
                        // the tags line, so a list of notes was scanned by the
                        // field a captured note does not even have.
                        //
                        // The empty state is drawn **instead of** the list rather
                        // than over it: an empty `ListView` is zero pixels tall
                        // and would leave the ＋ floating in a void with nothing
                        // to say why (ADR-0133). `filtered` distinguishes "you
                        // have no notes" from "this filter matched none of the
                        // notes you have" — the reference's empty state is the
                        // first, and showing it for the second is a page telling
                        // a reader with ninety notes that they have none.
                        if UIState.org-tab == 0 && UIState.note-rows.length == 0 : OrgEmptyState {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            filtered: UIState.org-query != "" || UIState.org-tag != ""
                                || UIState.org-excluded-label != "";
                        }
                        if UIState.org-tab == 0 && UIState.note-rows.length > 0 : ListView {
                            vertical-stretch: 1;
                            // One item = one row, plus the day-section header above it
                            // when this row starts one, plus a 2 px gutter. The gutter is
                            // small on purpose: the prototype's stream is a *stream*, and
                            // rows with 10 px between them read as cards again, which is
                            // the one thing this pass exists to stop.
                            //
                            // The height is the row's **own** preferred height and not a
                            // hand-written sum: the preview line wraps to two, and a sum
                            // written for one line would clip the second.
                            for n[i] in UIState.note-rows : Rectangle {
                                height: (n.first ? 34px : 0px) + note-row.preferred-height + 2px;
                                background: transparent;

                                if n.first : OrgSectionHead {
                                    y: 8px;
                                    width: parent.width;
                                    label: n.group;
                                    count: n.group-count;
                                }
                                note-row := OrgNoteRow {
                                    y: n.first ? 34px : 0px;
                                    // 6 px of scrollbar clearance, the width the card
                                    // beside it always left; the row's own text stops
                                    // short of its doors inside that.
                                    width: parent.width - 6px;
                                    note: n;
                                    opened => { UIState.org-note-selected(n.id); }
                                    menu-requested(x, y) => {
                                        UIState.org-note-menu-requested(n.id, x, y);
                                    }
                                    restored => { UIState.org-bin-restored(n.id); }
                                    purged => { UIState.org-bin-purged(n.id); }
                                }
                            }
                        }
                    }


                }

                // ── the detail column (任务's list mode, ADR-0118) ──────────
                // 340 px, always there: it used to slide out from 0, which meant
                // the list reflowed on every selection. Hidden on the board,
                // where the columns want the width — activitywatch's board does
                // the same. Its own edge goes with it: a divider with nothing
                // behind it is a line to nowhere.
                //
                // The note editor occupies its own column; list rows stay visible.
                if UIState.org-tab == 0 && UIState.org-note-detail.id >= 0 : Rectangle {
                    min-width: 340px;
                    preferred-width: 720px;
                    max-width: 100000px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    max-height: 100000px;
                    if UIState.org-capture-open && !UIState.quick-note-host : NoteCaptureCard {
                        x: 0px; y: 0px;
                        width: parent.width;
                        height: parent.height;
                        outlined: true;
                        draft <=> UIState.org-capture-draft;
                        caret: UIState.org-capture-caret;
                        suggestions: UIState.org-tag-suggestions;
                        submitted => { UIState.org-capture-sent(); }
                        dismissed => { UIState.org-capture-closed(); }
                        draft-edited => { UIState.org-capture-draft-changed(); }
                        suggestion-picked(tag) => { UIState.org-tag-suggest-picked(tag); }
                    }
                    if UIState.org-note-detail.id >= 0 && (!UIState.org-capture-open || UIState.quick-note-host) : Rectangle {
                        x: 0px; y: 0px;
                        width: parent.width;
                        height: parent.height;
                        border-radius: 0px;
                        border-width: 0px;
                        border-color: Colors.divider;
                        background: Colors.background;
                        clip: true;

                        // Swallows the card's own clicks — its padding, its title, the
                        // space under the last field — so that the rows beside it stay
                        // clickable and its own margin is not a hole onto them.
                        // Declared first, so every control below sits above it.
                        TouchArea { }

                        // The fields are a column taller than the card can be, so the
                        // page scrolls rather than clipping 详细信息 off the bottom.
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 16px;

                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 4px;
                                    Text {
                                        text: UIState.org-note-detail.when;
                                        horizontal-stretch: 1;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        font-weight: 400;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                    }
                                    IconButton {
                                        icon-name: "chevron-left";
                                        icon-color: Colors.text-muted;
                                        clicked => { UIState.org-note-closed(); }
                                    }
                                    IconButton {
                                        icon-name: "star";
                                        icon-color: UIState.org-note-detail.pinned
                                        ? Colors.accent-text
                                        : Colors.text-muted;
                                        clicked => { UIState.org-note-pin-toggled(UIState.org-note-detail.id); }
                                    }
                                    // 转为待办: the note becomes a task and the note goes —
                                    // no dialog, because the notice band is the way back.
                                    IconButton {
                                        icon-name: "todo-check";
                                        icon-color: Colors.text-muted;
                                        hover-color: Colors.accent-text;
                                        clicked => { UIState.org-note-to-task(UIState.org-note-detail.id); }
                                    }
                                    IconButton {
                                        icon-name: "trash";
                                        icon-color: Colors.text-muted;
                                        hover-color: Colors.danger;
                                        clicked => { UIState.org-note-deleted(UIState.org-note-detail.id); }
                                    }
                                    // The panel's own door, in the corner every popup in
                                    // this window closes from. Escape is the same ask.
                                }

                                // Legacy title text is retained as ordinary content; new memos only edit a body.
                                // Pinned to its own line: the old `hint-height:
                                // window-h - 440` on the body field below made the
                                // column taller than the viewport and the slack
                                // landed *above* the field — a dead band that grew
                                // with the window. The field now takes the slack
                                // itself (`vertical-stretch`), so nothing here may
                                // absorb it.
                                if UIState.org-note-detail.title != "" : Text {
                                    text: UIState.org-note-detail.title;
                                    max-height: self.preferred-height;
                                    vertical-stretch: 0;
                                    font-family: Typography.ui-font;
                                    font-size: 15px;
                                    color: Colors.text-primary;
                                    wrap: word-wrap;
                                }



                                OrgInput {
                                    placeholder: "开始记录…";
                                    multiline: true;
                                    recessed: true;
                                    // A floor, not a window-relative height: the
                                    // editor fills whatever the column has left
                                    // instead of pre-computing it and shoving the
                                    // remainder into the gap above itself.
                                    hint-height: 240px;
                                    vertical-stretch: 1;
                                    font-size: 15px;
                                    value <=> UIState.org-note-body-draft;
                                    edited => { UIState.org-field-edited(2); }
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    OrgField { name: "标签"; width: 40px; }
                                    OrgInput {
                                        placeholder: "用空格分隔标签";
                                        recessed: true;
                                        value <=> UIState.org-note-tags-draft;
                                        edited => { UIState.org-field-edited(3); }
                                    }
                                }

                                // 引用 (SPEC §四十一): the notes that answer this one, and
                                // the field that writes them — a reply is a note whose
                                // `ref_note` names this one (core ADR-0001). Committed on
                                // Enter or the 评论 button and not on a settle, because a
                                // reply is a *create* and half a row is not a row.
                                VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 26px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Icon {
                                                width: 14px;
                                                height: 14px;
                                                name: root.note-replies-open ? "chevron-down" : "chevron-right";
                                                size: 14px;
                                                color: Colors.text-muted;
                                            }
                                            Text {
                                                text: "评论 · " + UIState.org-note-replies.length;
                                                font-family: Typography.ui-font;
                                                font-size: Typography.size-caption;
                                                color: Colors.text-muted;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.note-replies-open = !root.note-replies-open; }
                                        }
                                    }
                                    if root.note-replies-open : VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 30px;
                                            spacing: 8px;
                                            OrgInput {
                                                placeholder: "写一条评论…";
                                                recessed: true;
                                                value <=> UIState.org-reply-draft;
                                                accepted => { UIState.org-reply-submitted(); }
                                            }
                                            IconButton {
                                                icon-name: "send";
                                                size: 30px;
                                                icon-color: Colors.accent-text;
                                                hover-color: Colors.accent-text;
                                                clicked => { UIState.org-reply-submitted(); }
                                            }
                                        }
                                        for reply[i] in UIState.org-note-replies : Rectangle {
                                            // The card hugs its text, the board card's own
                                            // idiom (`height` off the wrapped text's
                                            // preferred-height): a reply is a line or two, and
                                            // the card's leftover height must not be poured
                                            // into the newest one.
                                            height: reply-text.preferred-height + 14px + 18px;
                                            background: Colors.hover-fill;
                                            border-radius: Theme.radius-sm;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 2px;
                                                reply-text := Text {
                                                    text: reply.body != "" ? reply.body : reply.title;
                                                    font-family: Typography.ui-font;
                                                    font-size: Typography.size-ui;
                                                    color: Colors.text-primary;
                                                    wrap: word-wrap;
                                                }
                                                OrgMeta { tags: reply.tags; when: reply.when; height: 14px; }
                                            }
                                        }
                                    }
                                }

                                // 详细信息: what the store holds about this note, and
                                // the one thing it does not hold.
                                //
                                // A disclosure **below** the body rather than the
                                // reference's bottom sheet, for two reasons. Slint has
                                // no sheet, and a popup window for six read-only rows
                                // is a window inside a window; and opening it must not
                                // move the field the user is typing into — above the
                                // body it would shove 正文 down every time.
                                //
                                // The header is a Rectangle with a TouchArea under its
                                // text: a layout child that is only a row of text has
                                // nothing to click on for the empty part of the card.
                                Rectangle {
                                    height: 24px;
                                    details-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            UIState.org-note-details-open = !UIState.org-note-details-open;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        cross-axis-alignment: center;
                                        Icon {
                                            width: 14px;
                                            height: 14px;
                                            name: UIState.org-note-details-open
                                            ? "chevron-down"
                                            : "chevron-right";
                                            size: 14px;
                                            color: Colors.text-muted;
                                        }
                                        Text {
                                            text: "详细信息";
                                            font-family: Typography.ui-font;
                                            font-size: Typography.size-caption;
                                            color: Colors.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if UIState.org-note-details-open : VerticalLayout {
                                    spacing: 2px;
                                    OrgDetailRow { label: "编号"; value: UIState.org-note-details.id; }
                                    // SPEC §四十一's 唯一 ID: what 复制 hands an AI and
                                    // what a batch instruction names this note by. Next to
                                    // 编号 because they are both "which note", and only one
                                    // of them survives a sync.
                                    OrgDetailRow { label: "唯一 ID"; value: UIState.org-note-details.uuid; }
                                    OrgDetailRow { label: "创建"; value: UIState.org-note-details.created; }
                                    OrgDetailRow { label: "修改"; value: UIState.org-note-details.edited; }
                                    OrgDetailRow { label: "标签"; value: UIState.org-note-details.tags; }
                                    OrgDetailRow { label: "长度"; value: UIState.org-note-details.length; }
                                    OrgDetailRow { label: "置顶"; value: UIState.org-note-details.pinned; }
                                    // The reference says this out loud instead of
                                    // painting an empty 历史 list: `quire-core` keeps
                                    // one copy of a note, so there is no version to
                                    // restore to — 撤销 walks an edit back, and that
                                    // is all there is.
                                    Text {
                                        text: "没有历史版本：资料库只保存当前这一份，撤销可以回退编辑，但没有按时间恢复的版本。";
                                        wrap: word-wrap;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                    }
                                }
                            }
                        }
                    }
                }

                if UIState.org-tab == 1 && UIState.org-mode == 0 : Rectangle {
                    width: 7px;
                    vertical-stretch: 1;
                    max-height: 100000px;
                    background: resize-task.has-hover || root.detail-panel-resizing
                        ? Colors.hover-fill : transparent;
                    resize-task := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.col-resize;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.detail-panel-resizing = true;
                                root.detail-panel-start-width = root.detail-panel-width;
                                root.detail-panel-grab-x = self.mouse-x;
                            } else if (e.kind == PointerEventKind.move && root.detail-panel-resizing) {
                                    root.detail-panel-width = min(700px, max(160px,
                                    root.detail-panel-start-width - (self.mouse-x - root.detail-panel-grab-x)));
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                root.detail-panel-resizing = false;
                            }
                        }
                    }
                }
                if UIState.org-tab == 1 && UIState.org-mode == 0 : Rectangle {
                    min-width: 160px;
                    preferred-width: root.detail-panel-width;
                    max-width: 700px;
                    vertical-stretch: 1;
                    max-height: 100000px;
                    border-radius: 0px;
                    border-width: 0px;
                    border-color: Colors.border;
                    clip: true;
                    background: Colors.background;

                    // the column is 任务's alone (the gate above says so), so the
                    // pane inside it does not repeat the test
                    ScrollView {
                    VerticalLayout {
                        max-width: 760px;
                        padding: 16px;
                        spacing: 16px;
                        Text { text: "任务详情"; height: 22px; font-size: Typography.size-caption; font-weight: 600; color: Colors.text-primary; }

                        if UIState.org-task-detail.id < 0 : Text {
                            text: "选择一条任务，或按 ＋ 新建。";
                            font-family: Typography.ui-font;
                            font-size: Typography.size-ui;
                            color: Colors.text-muted;
                        }

                        if UIState.org-task-detail.id >= 0 : VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                    height: 64px;
                                spacing: 12px;
                                cross-axis-alignment: center;
                                OrgCheck {
                                    checked: UIState.org-task-detail.done;
                                    box-size: 18px;
                                    round: true;
                                    toggled => { UIState.org-task-done-toggled(UIState.org-task-detail.id); }
                                }
                                OrgInput {
                                    placeholder: "任务标题";
                                    multiline: true;
                                    hint-height: 60px;
                                    font-size: 22px;
                                    value <=> UIState.org-task-title-draft;
                                    edited => { UIState.org-field-edited(4); }
                                }
                                IconButton {
                                    icon-name: "trash";
                                    icon-color: Colors.text-muted;
                                    hover-color: Colors.danger;
                                    clicked => { UIState.org-task-deleted(UIState.org-task-detail.id); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                OrgField { name: "优先级"; width: 40px; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    max-width: 260px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 0px;
                                    border-color: Colors.border;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        spacing: 2px;
                                        for name[i] in root.priority-names : OrgButton {
                                            label: name;
                                            font-size: Typography.size-caption;
                                            selected: UIState.org-task-detail.priority == i;
                                            clicked => {
                                                UIState.org-task-priority-set(
                                                    UIState.org-task-detail.id, i);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                OrgField { name: "截止"; width: 40px; }
                                OrgInput {
                                    placeholder: "YYYY-MM-DD";
                                    grow: false;
                                    field-width: 108px;
                                    value <=> UIState.org-task-due-draft;
                                    edited => { UIState.org-field-edited(8); }
                                }
                                OrgButton {
                                    label: "今天";
                                    selected: UIState.org-task-detail.due == UIState.org-today;
                                    clicked => {
                                        UIState.org-task-due-set(
                                            UIState.org-task-detail.id,
                                            UIState.org-task-detail.due == UIState.org-today
                                                ? "" : UIState.org-today);
                                    }
                                }
                                if UIState.org-task-detail.due != "" : OrgButton {
                                    label: "清除";
                                    clicked => { UIState.org-task-due-set(UIState.org-task-detail.id, ""); }
                                }
                                if UIState.org-task-detail.overdue : Text {
                                    text: "已逾期";
                                    font-family: Typography.ui-font;
                                    font-size: Typography.size-caption;
                                    color: Colors.danger;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 34px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Colors.border;
                                background: Colors.surface;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: root.task-more-open ? "更多属性" : "更多属性  ·  清单、重复、标签和备注";
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Icon {
                                        width: 14px;
                                        height: 14px;
                                        name: root.task-more-open ? "chevron-down" : "chevron-right";
                                        size: 14px;
                                        color: Colors.text-muted;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.task-more-open = !root.task-more-open; }
                                }
                            }

                            if root.task-more-open : VerticalLayout {
                                spacing: 8px;

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    OrgField { name: "清单"; width: 40px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: Colors.border;
                                        HorizontalLayout {
                                            padding-left: 3px;
                                            padding-right: 3px;
                                            spacing: 2px;
                                            for entry[i] in UIState.task-list-rows : OrgButton {
                                                label: entry.name;
                                                color-slot: entry.smart ? -1 : entry.color;
                                                font-size: Typography.size-caption;
                                                selected: entry.smart
                                                    ? UIState.org-task-detail.list <= 0
                                                    : UIState.org-task-detail.list == entry.id;
                                                clicked => {
                                                    UIState.org-task-list-set(
                                                        UIState.org-task-detail.id,
                                                        entry.smart ? -1 : entry.id);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    OrgField { name: "重复"; width: 40px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: Colors.border;
                                        HorizontalLayout {
                                            padding-left: 3px;
                                            padding-right: 3px;
                                            spacing: 2px;
                                            for name[i] in root.repeat-names : OrgButton {
                                                label: name;
                                                font-size: Typography.size-caption;
                                                selected: UIState.org-task-detail.repeat == i;
                                                clicked => {
                                                    UIState.org-task-repeat-set(
                                                        UIState.org-task-detail.id, i);
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    OrgField { name: "标签"; width: 40px; }
                                    OrgInput {
                                        placeholder: "用空格分隔标签";
                                        recessed: true;
                                        value <=> UIState.org-task-tags-draft;
                                        edited => { UIState.org-field-edited(6); }
                                    }
                                }

                                OrgField { name: "备注"; height: 18px; }
                                OrgInput {
                                    placeholder: "备注";
                                    multiline: true;
                                    recessed: true;
                                    hint-height: 84px;
                                    value <=> UIState.org-task-notes-draft;
                                    edited => { UIState.org-field-edited(5); }
                                }
                            }

                            // the checklist: its own box, with the ＋ line
                            // *inside* it, so "add a line" reads as part of the
                            // list rather than as a second, unrelated control
                            VerticalLayout {
                                spacing: 0px;
                                OrgField {
                                    name: "子任务";
                                    height: 18px;
                                }
                                Rectangle {
                                    // Both ends pinned, not `height`: a box that
                                    // holds a scroll area takes its minimum from
                                    // that area's own, so a bare height is a
                                    // *preferred* one and the list pushes it back
                                    // open — the same lesson the columns' widths
                                    // taught (see `OrganizerArea`'s comment).
                                    min-height: 132px;
                                    max-height: 132px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 0px;
                                        subs := ListView {
                                            vertical-stretch: 1;
                                            for sub[i] in UIState.org-task-detail.subtasks : Rectangle {
                                                height: 44px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    cross-axis-alignment: center;
                                                    padding-left: 6px;
                                                    OrgCheck {
                                                        checked: sub.done;
                                                        box-size: 14px;
                                                        toggled => {
                                                            UIState.org-subtask-done-toggled(
                                                                UIState.org-task-detail.id,
                                                                sub.id, !sub.done);
                                                        }
                                                    }
                                                    // A line is text until it is
                                                    // clicked: several rows cannot
                                                    // share one draft, and the
                                                    // codebase's rule is one live
                                                    // input at a time.
                                                    if UIState.org-field == 7
                                                        && UIState.org-field-sub == sub.id : OrgInput {
                                                        placeholder: "子任务";
                                                        value <=> UIState.org-subtask-draft;
                                                        edited => { UIState.org-field-edited(7); }
                                                    }
                                                    if UIState.org-field != 7
                                                        || UIState.org-field-sub != sub.id : Text {
                                                        text: sub.title != "" ? sub.title : "子任务";
                                                        horizontal-stretch: 1;
                                                        max-width: 100000px;
                                                        font-family: Typography.ui-font;
                                                        font-size: Typography.size-ui;
                                                        color: sub.done
                                                            ? Colors.text-muted
                                                            : Colors.text-primary;
                                                        vertical-alignment: center;
                                                        wrap: word-wrap;
                                                    }
                                                    IconButton {
                                                        icon-name: "x";
                                                        size: 22px;
                                                        clicked => {
                                                            UIState.org-subtask-deleted(
                                                                UIState.org-task-detail.id, sub.id);
                                                        }
                                                    }
                                                }
                                                sub-ta := TouchArea {
                                                    // the title's own strip: the box
                                                    // and the ✕ are separate
                                                    // controls beside it, and a hit
                                                    // area over the whole row would
                                                    // swallow both
                                                    x: 22px;
                                                    y: 0;
                                                    width: parent.width - 50px;
                                                    height: parent.height;
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => {
                                                        UIState.org-subtask-edit(
                                                            UIState.org-task-detail.id, sub.id);
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 28px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 6px;
                                                OrgButton {
                                                    label: "＋ 添加子任务";
                                                    accent: true;
                                                    font-size: Typography.size-caption;
                                                    clicked => {
                                                        UIState.org-subtask-added(
                                                            UIState.org-task-detail.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                OrgField {
                                                    name: UIState.org-task-detail.subtasks-done + "/"
                                                        + UIState.org-task-detail.subtasks-total;
                                                    width: 40px;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            OrgButton {
                                height: 30px;
                                label: "删除任务";
                                danger: true;
                                clicked => {
                                    UIState.org-task-deleted(UIState.org-task-detail.id);
                                }
                            }
                        }
                    }
                    }
                }

                // ── the rail (the prototype's 右栏) ────────────────────────────
                // Keep the note tag navigator on the far right whether the list or a
                // selected note is showing: it follows the editor in this layout, so
                // opening a note never moves the navigator left.
                //
                // 214 px on the **sidebar's** colour. The rail is not a second list,
                // it is the column that says which list — and 214 is what a tag name
                // plus a count pill needs without eliding either of them.
                if UIState.org-tab == 0 : Rectangle {
                    preferred-width: 214px;
                    min-width: 180px;
                    max-width: 320px;
                    vertical-stretch: 1;
                    max-height: 100000px;
                    background: Colors.sidebar;
                    clip: true;
                    // One divider on its left edge: a `border-width` round the rail
                    // drew four, and three of them had nothing on the other side.
                    Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Colors.divider; }
                    ScrollView {
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            // 16, the rail's own padding. It used to be 84 while the
                            // list was up, because the toolbar floated *over* this
                            // column and the rail had to start underneath it.
                            padding-top: 16px;
                            // 72, not 16: the floating ＋ is pinned to the window's
                            // bottom-right corner, which is this column's bottom-right
                            // corner too, and a nav row under it is a nav row whose
                            // count nobody can read.
                            padding-bottom: 72px;
                            spacing: 8px;

                            OrgRailTitle {
                                label: "概览";
                                count: "" + UIState.org-note-count + " 篇";
                            }
                            HorizontalLayout {
                                height: 50px;
                                spacing: 8px;
                                OrgStatCard {
                                    value: UIState.org-note-week-count;
                                    label: "近 7 天";
                                }
                                OrgStatCard {
                                    value: UIState.org-tag-rows.length;
                                    label: "标签";
                                }
                            }
                            Rectangle { height: 12px; }
                            OrgRailTitle {
                                label: "标签";
                                count: "" + UIState.org-tag-rows.length;
                            }
                            OrgTagColumn { }
                            Rectangle { vertical-stretch: 1; min-height: 8px; }
                            // `.rail-foot`: 回收站 under a hairline of its own, because
                            // the bin is not another tag level and must not read as one.
                            Rectangle { height: 1px; background: Colors.divider; }
                            Rectangle { height: 6px; }
                            OrgNavRow {
                                label: "回收站";
                                count: UIState.org-bin-note-count;
                                selected: UIState.org-bin-open;
                                clicked => { UIState.org-bin-toggled(); }
                            }
                        }
                    }
                }

            }


        }
    }


    // Centered note composer for the list state. It is a page-level overlay so
    // the ＋ works even when no note is selected; placing it in the note detail
    // branch made the click update state without creating a visible card.
    if UIState.org-tab == 0 && UIState.org-note-detail.id < 0
        && UIState.org-capture-open && !UIState.quick-note-host : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Colors.scrim;
        TouchArea { clicked => { UIState.org-capture-closed(); } }
        NoteCaptureCard {
            x: (parent.width - min(520px, parent.width - 40px)) / 2;
            y: (parent.height - min(470px, parent.height - 48px)) / 2;
            width: min(520px, parent.width - 40px);
            height: min(470px, parent.height - 48px);
            outlined: true;
            draft <=> UIState.org-capture-draft;
            caret: UIState.org-capture-caret;
            suggestions: UIState.org-tag-suggestions;
            submitted => { UIState.org-capture-sent(); }
            dismissed => { UIState.org-capture-closed(); }
            draft-edited => { UIState.org-capture-draft-changed(); }
            suggestion-picked(tag) => { UIState.org-tag-suggest-picked(tag); }
        }
    }

    filter-menu := PopupWindow {
        x: 16px; y: 88px;
        width: 292px;
        height: min(620px, max(300px, UIState.window-h - 140px));
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Colors.border;
            background: Colors.surface-overlay;
            ScrollView {
                VerticalLayout {
                    if UIState.org-tab == 1 : VerticalLayout {

                        padding: 10px;
                        spacing: 1px;

                        // This column belongs to 任务; keep its add action without
                        // a second pair of tab controls that duplicates the sidebar.
                        HorizontalLayout {
                            height: 30px;
                            spacing: 2px;
                            Text {
                                text: "任务";
                                font-family: Typography.ui-font;
                                font-size: Typography.size-ui;
                                font-weight: Typography.weight-semibold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // The ＋ that makes the thing this tab is about — and
                            // only on 任务 (ADR-0115): the notes half's ＋ is the
                            // floating one at the list's bottom-right, and two
                            // buttons for one verb in one column pair is one button
                            // too many. 任务 keeps its own because a task has no
                            // capture layer — its quick-add line is already in the
                            // list, in the list the task lands in.
                        }

                        Rectangle { height: 6px; }

                        // 任务's own needle. The notes half's is in its filter bar
                        // (ADR-0118), and the two halves are never on screen
                        // together, so neither box is a second thing to clear.
                        OrgInput {
                            // `filled` for the same reason the notes half's
                            // needle has it: it is the one control on this column
                            // you click *into*, so it has to look like a field
                            // before the pointer arrives. The reference's task page
                            // draws its `m_search` with the same fill
                            // (`QLineEdit { background: %1; border: 1px solid
                            // transparent; border-radius: 9px; }`).
                            filled: true;
                            hint-height: 30px;
                            placeholder: "搜索任务";
                            value <=> UIState.org-query;
                            edited => { UIState.org-query-changed(); }
                        }

                        Rectangle { height: 6px; }

                        // ── 任务: the smart views, then the lists ───────────
                        // (The 笔记 half's 全部笔记 row and its tag column moved to
                        // the list's own filter bar — ADR-0118.)
                        if UIState.org-tab == 1 : VerticalLayout {
                            spacing: 1px;
                            for name[i] in root.smart-names : OrgNavRow {
                                label: name;
                                count: UIState.org-smart-counts[i];
                                // The bin is a place of its own: while it is open no
                                // view and no list is the one being looked at, and a
                                // second lit row would say otherwise.
                                selected: UIState.org-list < 0 && UIState.org-view == i
                                    && !UIState.org-bin-open;
                                clicked => { UIState.org-view-picked(i); filter-menu.close(); }
                            }
                            Rectangle { height: 8px; }
                            Text {
                                text: "清单";
                                height: 22px;
                                font-family: Typography.ui-font;
                                font-size: Typography.size-caption;
                                color: Colors.text-muted;
                                vertical-alignment: center;
                                x: 13px;
                            }
                            for entry[i] in UIState.task-list-rows : Rectangle {
                            height: entry.smart ? 0px : 32px;
                            if !entry.smart : OrgNavRow {
                                width: parent.width;
                                label: entry.name;
                                count: entry.count;
                                color-slot: entry.smart ? -1 : entry.color;
                                // The inbox is a *projection*, not a row: there is
                                // nothing there to rename, recolour or delete.
                                menuable: !entry.smart;
                                renaming: !entry.smart && UIState.org-list-renaming == entry.id;
                                selected: entry.smart
                                    ? UIState.org-list < 0 && UIState.org-view == 0
                                        && !UIState.org-bin-open
                                    : UIState.org-list == entry.id && !UIState.org-bin-open;
                                clicked => { UIState.org-list-picked(entry.id); filter-menu.close(); }
                                menu-requested(x, y) => {
                                    filter-menu.close();
                                    UIState.org-list-menu-requested(entry.id, x + root.absolute-position.x + 16px, y + root.absolute-position.y + 88px);
                                }
                                rename-committed(text) => {
                                    UIState.org-list-name-set(entry.id, text);
                                    UIState.org-list-renaming = -1;
                                }
                                rename-cancelled => { UIState.org-list-renaming = -1; }
                            }
                            }
                            OrgNavRow {
                                label: "＋ 新建清单";
                                accent: true;
                                clicked => { UIState.org-list-created(); }
                            }
                            // The 任务 tab's tag filter, below the lists: a task
                            // carries tags exactly as a note does, and 反向筛选 is
                            // the same two halves here as there.
                            Rectangle { height: 10px; }
                            OrgTagColumn { }
                        }

                        Rectangle { vertical-stretch: 1; min-height: 8px; }

                        // 回收站 (core ADR-0003): one row on **both** tabs, because
                        // what it holds is the half the user is standing on. Drawn
                        // last-but-one so it sits where a nav puts the place you go
                        // to when the list is not what you want.
                        OrgNavRow {
                            label: "回收站";
                            count: UIState.org-tab == 0
                                ? UIState.org-bin-note-count
                                : UIState.org-bin-task-count;
                            selected: UIState.org-bin-open;
                            clicked => { UIState.org-bin-toggled(); }
                        }

                        // the finished ones are a view like any other, so they
                        // sit where a nav puts the thing you go to last
                        if UIState.org-tab == 1 : OrgNavRow {
                            label: "已完成";
                            count: UIState.org-smart-counts[4];
                            selected: UIState.org-list < 0 && UIState.org-view == 4
                                && !UIState.org-bin-open;
                            clicked => { UIState.org-view-picked(4); }
                        }

                    }
                }
            }
        }
    }
    // Floating create action belongs to the active organizer page, at the
    // lower-right with a consistent inset from both edges.
    if UIState.org-tab == 0 || UIState.org-tab == 1 : Rectangle {
        x: root.width - 72px;
        y: root.height - 72px;
        width: 52px;
        height: 52px;
        border-radius: 26px;
        background: Colors.accent;
        border-width: 1px;
        border-color: Colors.accent;
        Icon {
            name: "plus";
            size: 22px;
            width: 22px;
            height: 22px;
            color: Colors.text-on-accent;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                if UIState.org-tab == 0 { UIState.org-capture-opened(); }
                else { UIState.org-task-create(); }
            }
        }
    }

    // ── 排序: the three orders, hanging under the pill ────────────────────────
    //
    // Drawn by the **area**, not by the `OrgSortBox`, because the box sits in the
    // 30 px filter-bar row and a layout gives a child only its own box to paint
    // in — the first `notes-sort` sweep showed three blue slivers and no words
    // where three orders should have been. It is the last of the area's children
    // before 指令 for the same reason 指令 and the capture layer are: a popup has
    // to be **above** the rows it covers, and only a later sibling in the same
    // component is.
    //
    // Only on the 笔记 half and not in the bin, because that is where the pill is:
    // a list for a control that is not on screen is a list with no way to close
    // it but picking an order.
    if UIState.org-tab == 0 && UIState.org-note-sort-open && !UIState.org-bin-open : OrgSortList {
        x: root.note-sort-x;
        y: root.note-sort-y;
        labels: root.note-sort-names;
        selected: UIState.org-note-sort;
        picked(slot) => {
            UIState.org-note-sort-open = false;
            UIState.org-note-sort-picked(slot);
        }
        closed => { UIState.org-note-sort-open = false; }
    }

    // ── 指令 (SPEC §四十一): the batch dialog ────────────────────────────────
    //
    // A card over the area rather than a window-level popup, because what it acts
    // on is *these* rows and the window has no text-entry overlay to reuse: the
    // delete confirmation is one line of message, and this is a page of JSON. Being
    // the last child of the area is what puts it above the three columns without a
    // second scrim in `AppWindow` — and the `TouchArea` is what makes the rows
    // behind it unclickable while a batch is being pasted.
    if UIState.org-cmd-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Colors.scrim;
        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // Bounded on both axes: a card that grew with its text would push its
            // own buttons off a short window, and the paste box is the one thing
            // that should scroll.
            width: min(parent.width - 60px, 680px);
            height: min(parent.height - 60px, 470px);
            background: Colors.surface-overlay;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Colors.border-strong;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    height: 24px;
                    text: UIState.org-cmd-tab == 1 ? "批量操作指令（任务）" : "批量操作指令（笔记）";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui-lg;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                }
                // The actions, spelled out: the same list the template carries, so
                // the box does not have to be read off the example. `delete` and
                // `restore` are 回收站's two verbs (core ADR-0003), which is why the
                // first one no longer throws the row away.
                Text {
                    height: 30px;
                    text: UIState.org-cmd-tab == 1
                        ? "粘贴 AI 返回的 JSON（{\"operations\":[…] }）。可用 action：create / update / delete / restore / add_tags / remove_tags / set_tags / set_completed / move / set_priority / set_due / add_subtask / set_subtask / remove_subtask / comment。delete 移入回收站，restore 取出。目标用 uuid（推荐，跨设备唯一）或 id。"
                        : "粘贴 AI 返回的 JSON（{\"operations\":[…] }）。可用 action：create / update / delete / restore / add_tags / remove_tags / set_tags / comment。delete 移入回收站，restore 取出。目标用 uuid（推荐，跨设备唯一）或 id。";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: cmd-input.has-focus ? Colors.border-strong : Colors.border;
                    background: Colors.background;
                    cmd-input := TextInput {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: parent.height - 12px;
                        text <=> UIState.org-cmd-text;
                        wrap: word-wrap;
                        font-family: Typography.mono-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-primary;
                        selection-foreground-color: Colors.text-on-accent;
                        selection-background-color: Colors.selection;
                    }
                    if UIState.org-cmd-text == "" : Text {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        text: "在此粘贴 JSON…";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-muted;
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 8px;
                    OrgButton {
                        label: "复制示例";
                        font-size: Typography.size-caption;
                        clicked => { UIState.org-command-example(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    OrgButton {
                        label: "取消";
                        font-size: Typography.size-caption;
                        clicked => { UIState.org-command-closed(); }
                    }
                    OrgButton {
                        label: "执行";
                        font-size: Typography.size-caption;
                        selected: true;
                        accent: true;
                        clicked => { UIState.org-command-run(); }
                    }
                }
            }
        }
    }


}
